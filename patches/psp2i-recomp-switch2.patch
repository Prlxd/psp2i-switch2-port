diff --git a/port/switch2/Makefile b/port/switch2/Makefile
new file mode 100644
index 0000000..68d1881
--- /dev/null
+++ b/port/switch2/Makefile
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: MIT
+# PSP2i on Switch 2 (kaiHEN): the NRO.
+#
+#   make DEVKITPRO=/opt/devkitpro PSPRECOMP=../../psprecomp AT3=<ppsspp>/ext/at3_standalone \
+#        GEN_OBJ=<dir of compiled port/gen parts> BUILD_NUM=<n>
+#
+# The game's code (port/gen, generated from your own EBOOT) is compiled separately,
+# split into parts (see build_gen.sh), because it is ~200 MB of C. Without GEN_OBJ the
+# NRO is built with gen_stub.c and only checks the game files.
+
+DEVKITPRO ?= /opt/devkitpro
+PSPRECOMP ?= ../../psprecomp
+AT3       ?= ../atrac_dll/at3_standalone
+GEN_OBJ   ?=
+BUILD_NUM ?= 0
+VERSION   ?= 0.9.2
+
+TARGET    := psp2i
+APP_TITLE := Phantasy Star Portable 2 Infinity (Switch 2 Port)
+APP_AUTHOR:= Prlxd
+ICON      ?= $(if $(wildcard icon_local.jpg),icon_local.jpg,icon.jpg)   # icon_local.jpg: a personal icon, never committed
+
+PREFIX  := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-
+CC      := $(PREFIX)gcc
+CXX     := $(PREFIX)g++
+LIBNX   := $(DEVKITPRO)/libounce
+PORTLIBS:= $(DEVKITPRO)/portlibs/switch
+PORTLIBS2:= $(DEVKITPRO)/portlibs/switch2
+TOOLS   := $(DEVKITPRO)/tools/bin
+SWITCH2_CPU := $(shell sed -n 's/^SWITCH2_CPU[[:space:]]*:=[[:space:]]*//p' $(LIBNX)/switch2_cpu.mk)
+
+ARCH    := $(SWITCH2_CPU) -mtp=soft -fPIE
+DEFS    := -D__SWITCH__ -D__SWITCH2__ -DPSP2I_SWITCH_BUILD=$(BUILD_NUM) -DPSP2I_SWITCH_VERSION=\"$(VERSION)\"
+INC     := $(EXTRA_INC) -I$(PSPRECOMP)/include -I../host -I$(AT3) -I../atrac_dll/shim -I$(PORTLIBS2)/include -I$(PORTLIBS)/include -isystem $(LIBNX)/include
+CFLAGS  = $(ARCH) -O2 -g0 -ffunction-sections -fdata-sections -std=gnu11 $(DEFS) $(INC)
+CXXFLAGS= $(ARCH) -O2 -g0 -ffunction-sections -fdata-sections -w $(DEFS) $(INC)
+LDFLAGS := -specs=$(LIBNX)/switch.specs $(ARCH) -Wl,--wrap=abort,--wrap=__assert_func -Wl,-Map,$(TARGET).map \
+           -Wl,--defsym,__data_start__=__data_start -Wl,--defsym,__data_end__=__bss_start__
+LIBS    := -L$(PORTLIBS2)/lib -L$(PORTLIBS)/lib -L$(LIBNX)/lib -lEGL -lz -lnx -lm
+
+RUNTIME := $(wildcard $(PSPRECOMP)/src/*.c) $(wildcard $(PSPRECOMP)/src/hle/*.c)
+HOST    := switch_main.c ../host/gl_ge.c ../host/gl_load.c ../host/camera.c ../host/framerate.c ../host/fastpaths.c \
+           ../host/menu.c ../host/postfx.c ../host/atrac_at3.c ../host/h264_static.c ../host/texpack.c
+AT3SRC  := $(addprefix $(AT3)/,atrac.cpp atrac3.cpp atrac3plus.cpp atrac3plusdec.cpp atrac3plusdsp.cpp \
+           get_bits.cpp compat.cpp fft.cpp mem.cpp) ../atrac_dll/at3_export.cpp
+
+# OPENH264=<OpenH264 source tree>, OPENH264_LIB=<its decoder built as a static
+# library>: movies decoded in the NRO (host/h264_static.c). Without them,
+# movies play black with sound.
+ifneq ($(strip $(OPENH264_LIB)),)
+DEFS    += -DPSP2I_H264_STATIC
+INC     += -I$(OPENH264)/codec/api
+LIBS    := $(OPENH264_LIB) $(LIBS)
+endif
+
+# VIDEO=software: a test build without OpenGL (libnx framebuffer + the software GE).
+ifeq ($(VIDEO),software)
+HOST    := $(filter-out ../host/gl_ge.c ../host/gl_load.c,$(HOST))
+DEFS    += -DPSP2I_SOFTWARE_VIDEO
+LIBS    := $(filter-out -lEGL,$(LIBS))
+TARGET  := psp2i-software
+endif
+
+# PROFILE=1: the sampling profiler (game code compiled with PSP_MARK as a store; see splitP).
+ifeq ($(PROFILE),1)
+DEFS    += -DPSP2I_PROFILE
+TARGET  := psp2i-profile
+APP_TITLE := PSP2i (profiling build)
+endif
+
+ifeq ($(strip $(GEN_OBJ)),)
+GEN     :=
+HOST    += ../android/src/gen_stub.c
+DEFS    += -DPSP2I_NO_GAME_CODE
+else
+GEN     := $(wildcard $(GEN_OBJ)/*.o)
+endif
+
+O := build-$(TARGET)
+OBJ := $(patsubst %,$(O)/%.o,$(notdir $(RUNTIME))) \
+       $(patsubst %,$(O)/h_%.o,$(notdir $(HOST))) \
+       $(patsubst %,$(O)/a_%.o,$(notdir $(AT3SRC)))
+vpath %.c $(PSPRECOMP)/src $(PSPRECOMP)/src/hle . ../host ../android/src
+vpath %.cpp $(AT3) ../atrac_dll
+
+all: $(TARGET).nro
+objs: $(OBJ)
+
+# The runtime: fastmem.h (inline main-RAM access, direct addressing) everywhere but mem.c,
+# which defines the real accessors; the VFPU at -O3.
+$(O)/%.c.o: %.c | $(O)
+	$(CC) $(CFLAGS) -w $(if $(filter mem.c,$(notdir $<)),,-include fastmem.h -DPSP2I_FASTMEM_NO_VFPU) $(if $(filter vfpu.c,$(notdir $<)),-O3,) -c $< -o $@
+$(O)/h_%.c.o: %.c | $(O)
+	$(CC) $(CFLAGS) -Wall -c $< -o $@
+$(O)/a_%.cpp.o: %.cpp | $(O)
+	$(CXX) $(CXXFLAGS) -c $< -o $@
+$(O):
+	mkdir -p $(O)
+
+# The host is rebuilt every time, so the build number in the log is always current.
+$(O)/h_switch_main.c.o: FORCE
+FORCE:
+
+$(TARGET).elf: $(OBJ) $(GEN)
+	$(CXX) $(LDFLAGS) $(OBJ) $(GEN) $(LIBS) -o $@
+
+$(TARGET).nacp:
+	$(TOOLS)/nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(VERSION)" $@
+
+$(TARGET).nro: $(TARGET).elf FORCE
+	rm -f $(TARGET).nacp
+	$(MAKE) $(TARGET).nacp
+	$(TOOLS)/elf2nro $< $@ --icon=$(if $(wildcard $(ICON)),$(ICON),$(LIBNX)/default_icon.jpg) --nacp=$(TARGET).nacp
+
+clean:
+	rm -rf build-* $(TARGET).elf $(TARGET).nro $(TARGET).nacp $(TARGET).map
+
+.PHONY: all clean FORCE
diff --git a/port/switch2/README.md b/port/switch2/README.md
new file mode 100644
index 0000000..3b1b67a
--- /dev/null
+++ b/port/switch2/README.md
@@ -0,0 +1,57 @@
+# Phantasy Star Portable 2 Infinity — Switch 2 (kaiHEN) port
+
+## Supported game version
+
+**This port only supports the English-patched ISO** (the fan translation, v2).
+The original, unpatched Japanese ISO is **not supported**:
+
+- its `EBOOT.BIN` is encrypted, so the port can't start it;
+- the port's game code was converted ahead of time from the English-patched
+  `EBOOT.BIN`, so a different version of the game's code would not match it.
+
+To make the English-patched ISO from your own Japanese copy of the game, follow
+the community guide:
+**https://psp2i.wiki/w/Installation#English_patch**
+
+## SD card layout
+
+```
+sdmc:/switch/psp2i/psp2i.nro
+sdmc:/switch/psp2i/<your English-patched ISO>.iso
+sdmc:/switch/psp2i/GameData/flash/font/      the PSP fonts
+sdmc:/switch/psp2i/GameData/ms/              saves (made on first save)
+sdmc:/switch/psp2i/textures/                 optional: PPSSPP-format texture packs
+```
+
+No game files are included; you supply your own copy of the game.
+
+## Default settings
+
+60 fps, FPS counter off, internal resolution 4x, draw distance far, fog off,
+anisotropic 4x, mipmaps on, custom textures off, scaling nearest. All of them
+can be changed in the in-game menu (saved to `sdmc:/switch/psp2i/psp2i.ini`).
+
+## Custom textures
+
+PPSSPP-format texture packs (a folder with a `textures.ini` and its PNGs) go in
+`sdmc:/switch/psp2i/textures/`. Turn CUSTOM TEXTURES on in the menu. The whole pack is
+loaded behind a loading bar at start-up, so nothing loads during play. The first
+start after adding or changing a pack also writes `textures/cache.bin`; later
+starts read that instead and load in a second or two. If you replace a PNG
+without changing `textures.ini`, delete `cache.bin` so it is made again.
+
+## Building
+
+1. Build `allegrexrecomp` from `psprecomp/` (cmake).
+2. Generate and compile the game's code from your own decrypted `EBOOT.BIN`:
+   `port/switch2/build_gen.sh <EBOOT.BIN> <work dir>`
+3. Build the NRO with the ounce devkit (libounce, OunceVK):
+   `make -C port/switch2 DEVKITPRO=<devkitpro> GEN_OBJ=<work dir>/obj AT3=<at3_standalone> OPENH264=<openh264 tree> OPENH264_LIB=<libopenh264dec.a>`
+
+## Credits
+
+Built on [PSP2I_Recomp](https://github.com/zmbkilla/PSP2I_Recomp) and
+[psprecomp](https://github.com/zmbkilla/psprecomp) by zmbkilla (psprecomp
+originally by sp00nznet), with the fan translation by the PSP2i community,
+OpenH264 for movies, and the ounce devkit / kaiHEN for the Switch 2.
+Switch 2 port by Prlxd, with Claude.
diff --git a/port/switch2/build_gen.sh b/port/switch2/build_gen.sh
new file mode 100755
index 0000000..f510326
--- /dev/null
+++ b/port/switch2/build_gen.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+# The game's code for the Switch 2 NRO: generated from your own EBOOT.BIN,
+# split, hooked to the port's native code and compiled into GEN_OBJ, which
+# the Makefile then links (make ... GEN_OBJ=<that dir>).
+#
+#   build_gen.sh <decrypted EBOOT.BIN of the English-patched ISO> <out dir> [jobs]
+#
+# Needs: DEVKITPRO (with libounce), python3, and allegrexrecomp built from
+# psprecomp/tools (cmake). ~200 MB of C: the compile takes a while.
+set -euo pipefail
+
+EBOOT=$1
+OUT=$2
+JOBS=${3:-4}
+HERE=$(cd "$(dirname "$0")" && pwd)
+PORT=$(cd "$HERE/.." && pwd)
+PSPRECOMP=${PSPRECOMP:-$(cd "$PORT/../psprecomp" && pwd)}
+DEVKITPRO=${DEVKITPRO:-/opt/devkitpro}
+RECOMP=${RECOMP:-$PSPRECOMP/build/tools/allegrexrecomp/allegrexrecomp}
+
+mkdir -p "$OUT/gen" "$OUT/split" "$OUT/obj"
+
+# 1. the game's code as C (hooks, fixes and the run-time switches of port/)
+"$RECOMP" emit "$EBOOT" "$OUT/gen" recomp --hooks "$PORT/hooks.txt" --fixes "$PORT/fixes.txt" --switches "$PORT/switches.txt"
+
+# 2. split into parts that compile alone, then the port's native entries
+python3 "$PORT/android/split_gen.py" "$OUT/gen/recomp_funcs.c" "$OUT/split" 64
+python3 "$HERE/gen_wrappers.py" "$OUT/split"
+
+# 3. compiled for the Switch 2
+export PATH=$DEVKITPRO/devkitA64/bin:$PATH
+CPU=$(sed -n 's/^SWITCH2_CPU[[:space:]]*:=[[:space:]]*//p' "$DEVKITPRO/libounce/switch2_cpu.mk")
+CFLAGS="$CPU -mtp=soft -fPIE -O2 -ffunction-sections -fdata-sections -D__SWITCH__ -D__SWITCH2__ \
+ -isystem $DEVKITPRO/libounce/include -I$DEVKITPRO/portlibs/switch/include \
+ -DPSPRECOMP_PREEMPT -std=gnu11 -g0 -w -I$PSPRECOMP/include -include $HERE/fastmem.h"
+export CFLAGS OUT
+ls "$OUT"/split/recomp_part_*.c | xargs -P"$JOBS" -I{} sh -c \
+  'aarch64-none-elf-gcc $CFLAGS -I"$OUT/split" -c {} -o "$OUT/obj/$(basename {} .c).o" || { echo "FAILED: {}"; exit 255; }'
+aarch64-none-elf-gcc $CFLAGS -I"$OUT/gen" -c "$OUT/gen/recomp_imports.c" -o "$OUT/obj/recomp_imports.o"
+echo "done: make GEN_OBJ=$OUT/obj ..."
diff --git a/port/switch2/fastmem.h b/port/switch2/fastmem.h
new file mode 100644
index 0000000..128f44a
--- /dev/null
+++ b/port/switch2/fastmem.h
@@ -0,0 +1,217 @@
+/* Switch 2: faster generated code (port/gen), forced in with -include.
+ *
+ * 1. The runtime's globals (psp_cpu, psp_mem, ...) are declared hidden: the
+ *    NRO is one statically linked position-independent image, so the code
+ *    can address them PC-relative instead of loading each address from the
+ *    GOT first.
+ * 2. PSP loads and stores inline: an access to main RAM while the runtime
+ *    says plain accesses need no checks (psp_fast_rd / psp_fast_wr, see
+ *    mem.c) is a bounds check and a host load or store; everything else --
+ *    VRAM, scratchpad, watches, traces -- still calls psp_read / psp_write.
+ *
+ * What the game does is unchanged; only the cost of doing it. */
+#ifndef PSP2I_SWITCH_FASTMEM_H
+#define PSP2I_SWITCH_FASTMEM_H
+
+#pragma GCC visibility push(hidden)
+#include <psprecomp/cpu.h>
+#include <psprecomp/mem.h>
+#include <psprecomp/recomp_rt.h>
+#include <psprecomp/dispatch.h>
+#include <psprecomp/vfpu.h>
+#pragma GCC visibility pop
+
+#include <string.h>
+
+#define FASTMEM_OFF(a) (((a) & PSP_ADDR_MASK) - PSP_RAM_BASE)
+
+#define FASTMEM_READ(NAME, SLOW, TYPE)                                              \
+    static inline __attribute__((always_inline)) TYPE NAME(uint32_t a) {            \
+        uint8_t *r = psp_fast_rd;                                                   \
+        const uint32_t o = FASTMEM_OFF(a);                                          \
+        if (__builtin_expect(r != NULL && o <= PSP_RAM_SIZE - sizeof(TYPE), 1)) {   \
+            TYPE v; memcpy(&v, r + o, sizeof v); return v;                          \
+        }                                                                           \
+        return SLOW(a);                                                             \
+    }
+#define FASTMEM_WRITE(NAME, SLOW, TYPE)                                             \
+    static inline __attribute__((always_inline)) void NAME(uint32_t a, TYPE v) {    \
+        uint8_t *r = psp_fast_wr;                                                   \
+        const uint32_t o = FASTMEM_OFF(a);                                          \
+        if (__builtin_expect(r != NULL && o <= PSP_RAM_SIZE - sizeof(TYPE), 1)) {   \
+            memcpy(r + o, &v, sizeof v); return;                                    \
+        }                                                                           \
+        SLOW(a, v);                                                                 \
+    }
+
+FASTMEM_READ(psp_fast_read8,  psp_read8,  uint8_t)
+FASTMEM_READ(psp_fast_read16, psp_read16, uint16_t)
+FASTMEM_READ(psp_fast_read32, psp_read32, uint32_t)
+FASTMEM_READ(psp_fast_read_f32, psp_read_f32, float)
+FASTMEM_WRITE(psp_fast_write8,  psp_write8,  uint8_t)
+FASTMEM_WRITE(psp_fast_write16, psp_write16, uint16_t)
+FASTMEM_WRITE(psp_fast_write32, psp_write32, uint32_t)
+FASTMEM_WRITE(psp_fast_write_f32, psp_write_f32, float)
+
+/* The generated code's calls (declared above) now go to the inline versions. */
+#define psp_read8(a)        psp_fast_read8(a)
+#define psp_read16(a)       psp_fast_read16(a)
+#define psp_read32(a)       psp_fast_read32(a)
+#define psp_read_f32(a)     psp_fast_read_f32(a)
+#define psp_write8(a, v)    psp_fast_write8((a), (v))
+#define psp_write16(a, v)   psp_fast_write16((a), (v))
+#define psp_write32(a, v)   psp_fast_write32((a), (v))
+#define psp_write_f32(a, v) psp_fast_write_f32((a), (v))
+
+#ifndef PSP2I_FASTMEM_NO_VFPU
+
+/* 3. VFPU operations the recompiler leaves as runtime calls, inline when no
+ *    prefix is pending (psp_vfpu_pfx_any == 0, so the runtime's prefix state
+ *    is already clear and consuming it is a no-op): the same arithmetic as
+ *    vfpu.c's no-prefix path. The register numbers are constants in the
+ *    generated code, so the lane addresses fold at compile time. Anything
+ *    prefixed goes to the runtime: (psp_vcmp)(...) calls the real function. */
+#include <math.h>
+
+/* vfpu.c regs_compute: lane i of operand `vreg` at `size` lanes. */
+static inline __attribute__((always_inline)) int psp_fvr(uint32_t vreg, int size, int i) {
+    const int mtx = (int)((vreg >> 2) & 7), col = (int)(vreg & 3);
+    int transpose = (int)((vreg >> 5) & 1), row;
+    switch (size) {
+    case 1:  row = (int)((vreg >> 5) & 3); transpose = 0; break;
+    case 3:  row = (int)((vreg >> 6) & 1); break;
+    default: row = (int)((vreg >> 5) & 2); break;
+    }
+    const int step = (row + i) & 3;
+    return transpose ? mtx * 4 + step * 32 + col : mtx * 4 + col * 32 + step;
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vcmp(uint32_t cond, uint32_t vs, uint32_t vt, int size) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4) { (psp_vcmp)(cond, vs, vt, size); return; }
+    uint32_t cc = 0;
+    int all = 1, any = 0;
+    for (int i = 0; i < size; i++) {
+        const float a = psp_cpu.v[psp_fvr(vs, size, i)], b = psp_cpu.v[psp_fvr(vt, size, i)];
+        int r;
+        switch (cond & 0xF) {
+        case 0:  r = 0; break;
+        case 1:  r = (a == b); break;
+        case 2:  r = (a <  b); break;
+        case 3:  r = (a <= b); break;
+        case 4:  r = 1; break;
+        case 5:  r = (a != b); break;
+        case 6:  r = (a >= b); break;
+        case 7:  r = (a >  b); break;
+        case 8:  r = (a == 0.0f); break;
+        case 9:  r = (a != a); break;
+        case 10: r = isinf(a) != 0; break;
+        case 11: r = (a != a) || isinf(a); break;
+        case 12: r = (a != 0.0f); break;
+        case 13: r = (a == a); break;
+        case 14: r = !isinf(a); break;
+        default: r = !((a != a) || isinf(a)); break;
+        }
+        if (r) { cc |= 1u << i; any = 1; } else all = 0;
+    }
+    if (any) cc |= 1u << 4;
+    if (all) cc |= 1u << 5;
+    const uint32_t affected = ((1u << size) - 1) | (1u << 4) | (1u << 5);
+    psp_cpu.vfpu_cc = (psp_cpu.vfpu_cc & ~affected) | cc;
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vcmov(uint32_t vd, uint32_t vs, int size, int tf, int imm3) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4) { (psp_vcmov)(vd, vs, size, tf, imm3); return; }
+    float s[4], cur[4];
+    for (int i = 0; i < size; i++) { s[i] = psp_cpu.v[psp_fvr(vs, size, i)]; cur[i] = psp_cpu.v[psp_fvr(vd, size, i)]; }
+    const uint32_t cc = psp_cpu.vfpu_cc;
+    const int want = tf ? 0 : 1;
+    for (int i = 0; i < size; i++) {
+        const int bit = imm3 < 6 ? imm3 : (imm3 == 6 ? i : -1);
+        if (bit >= 0 && (int)((cc >> bit) & 1) == want) cur[i] = s[i];
+    }
+    for (int i = 0; i < size; i++) psp_cpu.v[psp_fvr(vd, size, i)] = cur[i];
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vunary(int op, uint32_t vd, uint32_t vs, int size) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4 || op > PSP_VU_I2F) { (psp_vunary)(op, vd, vs, size); return; }
+    float o[4];
+    for (int i = 0; i < size; i++) {
+        const float a = psp_cpu.v[psp_fvr(vs, size, i)];
+        float r;
+        switch (op) {
+        case PSP_VU_MOV:  r = a; break;
+        case PSP_VU_ABS:  r = fabsf(a); break;
+        case PSP_VU_NEG:  r = -a; break;
+        case PSP_VU_ZERO: r = 0.0f; break;
+        case PSP_VU_ONE:  r = 1.0f; break;
+        case PSP_VU_RCP:  r = 1.0f / a; break;
+        case PSP_VU_NRCP: r = -1.0f / a; break;
+        case PSP_VU_RSQ:  r = 1.0f / psp_fsqrt(a); break;
+        case PSP_VU_SQRT: r = psp_fsqrt(a); break;
+        case PSP_VU_SIN:  r = sinf(a * 1.5707963267948966f); break;
+        case PSP_VU_COS:  r = cosf(a * 1.5707963267948966f); break;
+        case PSP_VU_NSIN: r = -sinf(a * 1.5707963267948966f); break;
+        case PSP_VU_ASIN: r = asinf(a) * 0.6366197723675814f; break;
+        case PSP_VU_EXP2: r = powf(2.0f, a); break;
+        case PSP_VU_REXP2:r = 1.0f / powf(2.0f, a); break;
+        case PSP_VU_LOG2: r = logf(a) * 1.4426950408889634f; break;
+        case PSP_VU_SAT0: r = a < 0.0f ? 0.0f : (a > 1.0f ? 1.0f : a); break;
+        case PSP_VU_SAT1: r = a < -1.0f ? -1.0f : (a > 1.0f ? 1.0f : a); break;
+        case PSP_VU_F2IZ: r = psp_bits_to_f32((uint32_t)(int32_t)a); break;
+        default:          r = (float)(int32_t)psp_f32_to_bits(a); break;   /* PSP_VU_I2F */
+        }
+        o[i] = r;
+    }
+    for (int i = 0; i < size; i++) psp_cpu.v[psp_fvr(vd, size, i)] = o[i];
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vi2f(uint32_t vd, uint32_t vs, uint32_t scale, int size) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4) { (psp_vi2f)(vd, vs, scale, size); return; }
+    const double k = 1.0 / (double)(1u << (scale & 31));
+    float o[4];
+    for (int i = 0; i < size; i++) o[i] = (float)((double)(int32_t)psp_f32_to_bits(psp_cpu.v[psp_fvr(vs, size, i)]) * k);
+    for (int i = 0; i < size; i++) psp_cpu.v[psp_fvr(vd, size, i)] = o[i];
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vf2i(int mode, uint32_t vd, uint32_t vs, uint32_t scale, int size) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4) { (psp_vf2i)(mode, vd, vs, scale, size); return; }
+    const double k = (double)(1u << (scale & 31));
+    uint32_t o[4];
+    for (int i = 0; i < size; i++) {
+        const double x = (double)psp_cpu.v[psp_fvr(vs, size, i)] * k;
+        int32_t r;
+        if (x != x)                  r = 0x7FFFFFFF;
+        else if (x >= 2147483647.0)  r = 0x7FFFFFFF;
+        else if (x <= -2147483648.0) r = (int32_t)0x80000000u;
+        else switch (mode) {
+            case PSP_VF2I_NEAREST: r = (int32_t)nearbyint(x); break;
+            case PSP_VF2I_ZERO:    r = (int32_t)x; break;
+            case PSP_VF2I_UP:      r = (int32_t)ceil(x); break;
+            default:               r = (int32_t)floor(x); break;
+        }
+        o[i] = (uint32_t)r;
+    }
+    for (int i = 0; i < size; i++) psp_cpu.v[psp_fvr(vd, size, i)] = psp_bits_to_f32(o[i]);
+}
+
+static inline __attribute__((always_inline)) void psp_fast_vidt(uint32_t vd, int size) {
+    if (__builtin_expect(psp_vfpu_pfx_any != 0, 0) || size < 1 || size > 4) { (psp_vidt)(vd, size); return; }
+    const int one = (int)(vd & (size == 2 ? 1u : 3u));
+    for (int i = 0; i < size; i++) psp_cpu.v[psp_fvr(vd, size, i)] = (i == one) ? 1.0f : 0.0f;
+}
+
+static inline __attribute__((always_inline)) void psp_fast_mtv(uint32_t reg, uint32_t value) {
+    if (reg < 128) { psp_cpu.v[psp_fvr(reg, 1, 0)] = psp_bits_to_f32(value); return; }
+    (psp_mtv)(reg, value);
+}
+
+#define psp_vcmp(c, s, t, n)        psp_fast_vcmp((c), (s), (t), (n))
+#define psp_vcmov(d, s, n, tf, i)   psp_fast_vcmov((d), (s), (n), (tf), (i))
+#define psp_vunary(op, d, s, n)     psp_fast_vunary((op), (d), (s), (n))
+#define psp_vi2f(d, s, k, n)        psp_fast_vi2f((d), (s), (k), (n))
+#define psp_vf2i(m, d, s, k, n)     psp_fast_vf2i((m), (d), (s), (k), (n))
+#define psp_vidt(d, n)              psp_fast_vidt((d), (n))
+#define psp_mtv(r, v)               psp_fast_mtv((r), (v))
+#endif
+
+#endif
diff --git a/port/switch2/gen_wrappers.py b/port/switch2/gen_wrappers.py
new file mode 100755
index 0000000..532a054
--- /dev/null
+++ b/port/switch2/gen_wrappers.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Hook the Switch 2 port's native code into the generated game code.
+
+The game's code (port/gen, generated from your own EBOOT by allegrexrecomp) is
+split into parts by port/android/split_gen.py. This adds the port's entries to
+those parts: each listed game function's psp_func_ stub first calls a host
+function (port/host/fastpaths.c). For a "fast" entry, a nonzero return means
+the host did the work and the game's own code is skipped; for a "pre" entry the
+host runs first and the game's code always follows.
+
+    gen_wrappers.py <dir of recomp_part_*.c>
+
+Safe to run again: a part already wrapped is left as it is.
+"""
+import glob
+import re
+import sys
+
+ENTRIES = [
+    # address,     kind,   host function
+    ("08A46A50", "pre",  "psp2i_fix_approach_speed"),       # the roll's first step, scaled to the frame rate
+    ("08B8C5C0", "fast", "psp2i_fast_vram_restore"),        # RAM -> VRAM block copy
+    ("08B8C6AC", "fast", "psp2i_fast_vram_save"),           # VRAM -> RAM block copy
+    ("08D5DEE8", "fast", "psp2i_fast_prs"),                 # PRS decompression
+    ("08D65A18", "fast", "psp2i_fast_blowfish"),            # Blowfish decryption
+    ("08DE0C40", "fast", "psp2i_fast_deflate_decompress"),  # sceDeflateDecompress
+]
+
+
+def wrapped(addr, kind, fn):
+    if kind == "pre":
+        return f"void {fn}(void); void psp_func_{addr}(void) {{ {fn}(); psp_body_{addr}(0x{addr}u); }}"
+    return f"int {fn}(void); void psp_func_{addr}(void) {{ if ({fn}()) return; psp_body_{addr}(0x{addr}u); }}"
+
+
+def main(d):
+    parts = sorted(glob.glob(f"{d}/recomp_part_*.c"))
+    if not parts:
+        sys.exit(f"no recomp_part_*.c in {d}")
+    todo = {a: (k, f) for a, k, f in ENTRIES}
+    for p in parts:
+        s = open(p, encoding="utf-8").read()
+        changed = False
+        for addr, (kind, fn) in list(todo.items()):
+            plain = f"void psp_func_{addr}(void) {{ psp_body_{addr}(0x{addr}u); }}"
+            new = wrapped(addr, kind, fn)
+            if new in s:
+                del todo[addr]
+            elif plain in s:
+                s = s.replace(plain, new, 1)
+                changed = True
+                del todo[addr]
+        if changed:
+            open(p, "w", encoding="utf-8").write(s)
+    if todo:
+        sys.exit("not found (a different EBOOT?): " + ", ".join(todo))
+    print(f"{len(ENTRIES)} entries in place")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
