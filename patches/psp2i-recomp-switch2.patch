diff --git a/port/host/texpack.c b/port/host/texpack.c
new file mode 100644
index 0000000..5d61aae
--- /dev/null
+++ b/port/host/texpack.c
@@ -0,0 +1,421 @@
+/* Custom textures: PPSSPP texture packs (textures.ini + PNGs).
+ *
+ * A pack is a folder with a textures.ini whose [hashes] section names each
+ * replaced texture by PPSSPP's key (16 hex digits of cache key -- the address,
+ * zero with ignoreAddress, then dimension ^ palette hash -- and 8 of data
+ * hash; psp_gpu_pack_key computes the same) and gives a PNG path relative to
+ * the ini. Every folder under the packs root that has one (searched three
+ * levels deep, so a PPSSPP layout PSP/TEXTURES/<id>/ works too) is loaded,
+ * in name order; a later pack's entry for the same key wins.
+ *
+ * PNGs are decoded on a worker thread: the first draws of a texture use the
+ * game's own until the replacement is ready, so a new area never waits on a
+ * decode. The renderer uploads decoded images (texpack_take) and keeps them. */
+
+#include "texpack.h"
+
+#include <dirent.h>
+#include <pthread.h>
+#include <time.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <zlib.h>
+
+typedef struct {
+    uint32_t lo, hash;      /* the key (lo 0: any dimension/palette, PPSSPP's wildcard) */
+    char    *path;
+    volatile int state;     /* 0 not loaded, 1 queued, 2 decoded (px), 3 taken, -1 failed */
+    uint8_t *px;
+    int      w, h;
+} tp_entry;
+
+static tp_entry *g_e;
+static int g_n, g_cap;
+static int *g_table;        /* open addressing on (lo, hash) -> entry index */
+static uint32_t g_table_mask;
+static int g_loaded, g_use_xxh64 = 1;
+static int g_packs;
+
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static int g_queue[1024];
+static unsigned g_qhead, g_qtail;
+static unsigned long g_decoded, g_failed;
+static uint64_t g_ini_sig = 0xCBF29CE484222325ull;
+
+/* ---- PNG ------------------------------------------------------------------------------------ */
+
+static uint32_t be32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+static int paeth(int a, int b, int c) {
+    int p = a + b - c, pa = abs(p - a), pb = abs(p - b), pc = abs(p - c);
+    return pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
+}
+
+/* RGBA8 of a PNG file (non-interlaced, 8-bit: grey, RGB, palette, grey+alpha,
+ * RGBA; also 16-bit and 1/2/4-bit palette/grey). NULL on anything else. */
+static uint8_t *png_decode(const uint8_t *f, size_t n, int *ow, int *oh) {
+    static const uint8_t sig[8] = { 137, 'P', 'N', 'G', 13, 10, 26, 10 };
+    if (n < 33 || memcmp(f, sig, 8)) return NULL;
+    uint32_t w = 0, h = 0; int depth = 0, ctype = 0, interlace = 0;
+    uint8_t pal[256][4]; int npal = 0;
+    memset(pal, 255, sizeof pal);
+    int trns_grey = -1, trns_r = -1, trns_g = -1, trns_b = -1;
+    uint8_t *idat = NULL; size_t idn = 0, idcap = 0;
+    size_t pos = 8;
+    while (pos + 12 <= n) {
+        const uint32_t len = be32(f + pos);
+        const uint8_t *type = f + pos + 4, *d = f + pos + 8;
+        if (pos + 12 + (size_t)len > n) break;
+        if (!memcmp(type, "IHDR", 4) && len >= 13) {
+            w = be32(d); h = be32(d + 4); depth = d[8]; ctype = d[9]; interlace = d[12];
+        } else if (!memcmp(type, "PLTE", 4)) {
+            npal = (int)(len / 3); if (npal > 256) npal = 256;
+            for (int i = 0; i < npal; i++) { pal[i][0] = d[i * 3]; pal[i][1] = d[i * 3 + 1]; pal[i][2] = d[i * 3 + 2]; }
+        } else if (!memcmp(type, "tRNS", 4)) {
+            if (ctype == 3) for (uint32_t i = 0; i < len && i < 256; i++) pal[i][3] = d[i];
+            else if (ctype == 0 && len >= 2) trns_grey = d[0] << 8 | d[1];
+            else if (ctype == 2 && len >= 6) { trns_r = d[0] << 8 | d[1]; trns_g = d[2] << 8 | d[3]; trns_b = d[4] << 8 | d[5]; }
+        } else if (!memcmp(type, "IDAT", 4)) {
+            if (idn + len > idcap) {
+                idcap = (idn + len) * 2;
+                uint8_t *nb = (uint8_t *)realloc(idat, idcap);
+                if (!nb) { free(idat); return NULL; }
+                idat = nb;
+            }
+            memcpy(idat + idn, d, len); idn += len;
+        } else if (!memcmp(type, "IEND", 4)) break;
+        pos += 12 + (size_t)len;
+    }
+    if (!w || !h || w > 8192 || h > 8192 || interlace || !idat) { free(idat); return NULL; }
+    int chans = ctype == 0 ? 1 : ctype == 2 ? 3 : ctype == 3 ? 1 : ctype == 4 ? 2 : ctype == 6 ? 4 : 0;
+    if (!chans || (depth != 8 && depth != 16 && !(depth < 8 && (ctype == 0 || ctype == 3)))) { free(idat); return NULL; }
+    const size_t bitspp = (size_t)chans * depth, stride = (w * bitspp + 7) / 8, bpp = bitspp >= 8 ? bitspp / 8 : 1;
+    const size_t rawn = (stride + 1) * h;
+    uint8_t *raw = (uint8_t *)malloc(rawn);
+    if (!raw) { free(idat); return NULL; }
+    z_stream zs; memset(&zs, 0, sizeof zs);
+    int ok = inflateInit(&zs) == Z_OK;
+    if (ok) {
+        zs.next_in = idat; zs.avail_in = (uInt)idn; zs.next_out = raw; zs.avail_out = (uInt)rawn;
+        const int r = inflate(&zs, Z_FINISH);
+        ok = (r == Z_STREAM_END || r == Z_OK || r == Z_BUF_ERROR) && zs.total_out == rawn;
+        inflateEnd(&zs);
+    }
+    free(idat);
+    if (!ok) { free(raw); return NULL; }
+    /* Unfilter in place: each row starts with its filter byte. */
+    uint8_t *prev = NULL;
+    for (uint32_t y = 0; y < h; y++) {
+        uint8_t *row = raw + y * (stride + 1);
+        const int ft = row[0];
+        uint8_t *c = row + 1;
+        for (size_t i = 0; i < stride; i++) {
+            const int a = i >= bpp ? c[i - bpp] : 0, b = prev ? prev[i] : 0, cc = prev && i >= bpp ? prev[i - bpp] : 0;
+            switch (ft) {
+            case 1: c[i] = (uint8_t)(c[i] + a); break;
+            case 2: c[i] = (uint8_t)(c[i] + b); break;
+            case 3: c[i] = (uint8_t)(c[i] + ((a + b) >> 1)); break;
+            case 4: c[i] = (uint8_t)(c[i] + paeth(a, b, cc)); break;
+            default: break;
+            }
+        }
+        prev = c;
+    }
+    uint8_t *out = (uint8_t *)malloc((size_t)w * h * 4);
+    if (!out) { free(raw); return NULL; }
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t *c = raw + y * (stride + 1) + 1;
+        uint8_t *o = out + (size_t)y * w * 4;
+        for (uint32_t x = 0; x < w; x++, o += 4) {
+            if (depth < 8) {
+                const int per = 8 / depth, sh = (per - 1 - (int)(x % per)) * depth;
+                int v = (c[x / per] >> sh) & ((1 << depth) - 1);
+                if (ctype == 3) { memcpy(o, pal[v], 4); }
+                else { const int g = v * 255 / ((1 << depth) - 1); o[0] = o[1] = o[2] = (uint8_t)g; o[3] = v == trns_grey ? 0 : 255; }
+                continue;
+            }
+            const size_t sz = depth / 8;
+            const uint8_t *s = c + x * chans * sz;
+            #define CH(i) (s[(i) * sz])
+            #define CH16(i) (sz == 2 ? (s[(i) * 2] << 8 | s[(i) * 2 + 1]) : s[(i)])
+            switch (ctype) {
+            case 0: o[0] = o[1] = o[2] = CH(0); o[3] = CH16(0) == trns_grey ? 0 : 255; break;
+            case 2: o[0] = CH(0); o[1] = CH(1); o[2] = CH(2);
+                    o[3] = (CH16(0) == trns_r && CH16(1) == trns_g && CH16(2) == trns_b) ? 0 : 255; break;
+            case 3: memcpy(o, pal[CH(0)], 4); break;
+            case 4: o[0] = o[1] = o[2] = CH(0); o[3] = CH(1); break;
+            default: o[0] = CH(0); o[1] = CH(1); o[2] = CH(2); o[3] = CH(3); break;
+            }
+            #undef CH
+            #undef CH16
+        }
+    }
+    free(raw);
+    *ow = (int)w; *oh = (int)h;
+    return out;
+}
+
+static uint8_t *load_png(const char *path, int *w, int *h) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    const long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (n <= 0 || n > 256L * 1024 * 1024) { fclose(f); return NULL; }
+    uint8_t *buf = (uint8_t *)malloc((size_t)n);
+    if (!buf) { fclose(f); return NULL; }
+    const size_t got = fread(buf, 1, (size_t)n, f);
+    fclose(f);
+    uint8_t *px = got == (size_t)n ? png_decode(buf, (size_t)n, w, h) : NULL;
+    free(buf);
+    return px;
+}
+
+/* ---- the worker ----------------------------------------------------------------------------- */
+
+/* No loader thread: under kaiHEN a thread the port makes itself that reads
+ * files crashes the game about every other boot (and no crash log gets
+ * written). So the PNGs load on the game's own thread, a few per vblank, from
+ * texpack_pump. */
+static double now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+void texpack_pump(double budget_ms) {
+    if (g_qhead == g_qtail) return;
+    const double t0 = now_ms();
+    do {
+        pthread_mutex_lock(&g_mu);
+        if (g_qhead == g_qtail) { pthread_mutex_unlock(&g_mu); break; }
+        const int id = g_queue[g_qhead++ % 1024];
+        pthread_mutex_unlock(&g_mu);
+        tp_entry *e = &g_e[id];
+        int w = 0, h = 0;
+        uint8_t *px = load_png(e->path, &w, &h);
+        if (px) { e->px = px; e->w = w; e->h = h; __sync_synchronize(); e->state = 2; g_decoded++; }
+        else { e->state = -1; g_failed++; fprintf(stderr, "texpack: could not load %s\n", e->path); }
+    } while (now_ms() - t0 < budget_ms);
+}
+
+/* ---- the index ------------------------------------------------------------------------------ */
+
+static uint32_t mix(uint32_t lo, uint32_t hash) { return (lo * 0x9E3779B1u) ^ (hash * 0x85EBCA77u) ^ (hash >> 15); }
+
+static void table_build(void) {
+    uint32_t size = 1;
+    while (size < (uint32_t)g_n * 2 + 16) size <<= 1;
+    free(g_table);
+    g_table = (int *)malloc(size * sizeof(int));
+    if (!g_table) { g_table_mask = 0; return; }
+    for (uint32_t i = 0; i < size; i++) g_table[i] = -1;
+    g_table_mask = size - 1;
+    for (int i = 0; i < g_n; i++) {
+        uint32_t k = mix(g_e[i].lo, g_e[i].hash) & g_table_mask;
+        while (g_table[k] >= 0) {
+            tp_entry *o = &g_e[g_table[k]];
+            if (o->lo == g_e[i].lo && o->hash == g_e[i].hash) break;   /* a later pack overrides */
+            k = (k + 1) & g_table_mask;
+        }
+        g_table[k] = i;
+    }
+}
+
+static int find(uint32_t lo, uint32_t hash) {
+    if (!g_table) return -1;
+    uint32_t k = mix(lo, hash) & g_table_mask;
+    while (g_table[k] >= 0) {
+        const tp_entry *e = &g_e[g_table[k]];
+        if (e->lo == lo && e->hash == hash) return g_table[k];
+        k = (k + 1) & g_table_mask;
+    }
+    return -1;
+}
+
+static int hexval(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
+
+static void load_ini(const char *dir) {
+    char path[1024];
+    snprintf(path, sizeof path, "%s/textures.ini", dir);
+    FILE *f = fopen(path, "rb");
+    if (!f) return;
+    {   /* into the cache signature: a changed ini rebuilds the cache */
+        struct stat st;
+        if (!stat(path, &st)) g_ini_sig = (g_ini_sig ^ (uint64_t)st.st_size ^ ((uint64_t)st.st_mtime << 20)) * 0x100000001B3ull;
+    }
+    char line[1024];
+    int section = 0, count = 0;   /* 1 = [options], 2 = [hashes] */
+    while (fgets(line, sizeof line, f)) {
+        char *s = line;
+        while (*s == ' ' || *s == '\t' || (unsigned char)*s == 0xEF || (unsigned char)*s == 0xBB || (unsigned char)*s == 0xBF) s++;
+        size_t L = strlen(s);
+        while (L && (s[L - 1] == '\n' || s[L - 1] == '\r' || s[L - 1] == ' ' || s[L - 1] == '\t')) s[--L] = 0;
+        if (!*s || *s == '#' || *s == ';') continue;
+        if (*s == '[') { section = !strncasecmp(s, "[options]", 9) ? 1 : !strncasecmp(s, "[hashes]", 8) ? 2 : 0; continue; }
+        char *eq = strchr(s, '=');
+        if (!eq) continue;
+        char *val = eq + 1;
+        *eq = 0;
+        while (*val == ' ' || *val == '\t' || *val == '"') val++;
+        L = strlen(val);
+        while (L && (val[L - 1] == '"' || val[L - 1] == ' ')) val[--L] = 0;
+        L = strlen(s);
+        while (L && (s[L - 1] == ' ' || s[L - 1] == '\t')) s[--L] = 0;
+        if (section == 1) {
+            if (!strcasecmp(s, "hash")) g_use_xxh64 = !strcasecmp(val, "xxh64");
+            continue;
+        }
+        if (section != 2 || strlen(s) < 24 || !*val) continue;
+        uint32_t v[3] = { 0, 0, 0 };
+        int bad = 0;
+        for (int i = 0; i < 24 && !bad; i++) { const int h = hexval(s[i]); if (h < 0) bad = 1; else v[i / 8] = v[i / 8] << 4 | (uint32_t)h; }
+        if (bad || (s[24] && s[24] != '_')) continue;          /* mip levels (_1 ...) are not used */
+        if (s[24] == '_') continue;
+        if (g_n == g_cap) {
+            g_cap = g_cap ? g_cap * 2 : 4096;
+            tp_entry *ne = (tp_entry *)realloc(g_e, (size_t)g_cap * sizeof *g_e);
+            if (!ne) break;
+            g_e = ne;
+        }
+        tp_entry *e = &g_e[g_n];
+        memset(e, 0, sizeof *e);
+        e->lo = v[1]; e->hash = v[2];                          /* the address (v[0]) is ignored */
+        const size_t pl = strlen(dir) + 1 + strlen(val) + 1;
+        e->path = (char *)malloc(pl);
+        if (!e->path) break;
+        snprintf(e->path, pl, "%s/%s", dir, val);
+        for (char *c = e->path; *c; c++) if (*c == '\\') *c = '/';
+        g_n++; count++;
+    }
+    fclose(f);
+    g_packs++;
+    fprintf(stderr, "texpack: %s: %d textures\n", dir, count);
+}
+
+static int name_cmp(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
+
+static void scan(const char *dir, int depth) {
+    char path[1024];
+    snprintf(path, sizeof path, "%s/textures.ini", dir);
+    struct stat st;
+    if (!stat(path, &st)) { load_ini(dir); return; }
+    if (depth <= 0) return;
+    DIR *d = opendir(dir);
+    if (!d) return;
+    char *names[256]; int nn = 0;
+    struct dirent *de;
+    while ((de = readdir(d)) && nn < 256) {
+        if (de->d_name[0] == '.') continue;
+        snprintf(path, sizeof path, "%s/%s", dir, de->d_name);
+        if (stat(path, &st) || !S_ISDIR(st.st_mode)) continue;
+        names[nn++] = strdup(de->d_name);
+    }
+    closedir(d);
+    qsort(names, (size_t)nn, sizeof names[0], name_cmp);
+    for (int i = 0; i < nn; i++) {
+        snprintf(path, sizeof path, "%s/%s", dir, names[i]);
+        scan(path, depth - 1);
+        free(names[i]);
+    }
+}
+
+int texpack_load(const char *root) {
+    if (g_loaded) return g_n;
+    g_loaded = 1;
+    scan(root, 3);
+    table_build();
+    fprintf(stderr, "texpack: %d textures from %d pack%s under %s (hash %s)\n", g_n, g_packs, g_packs == 1 ? "" : "s", root,
+            g_use_xxh64 ? "xxh64" : "xxh32");
+    return g_n;
+}
+
+int texpack_xxh64(void) { return g_use_xxh64; }
+
+int texpack_find(uint32_t lo, uint32_t hash) {
+    int i = find(lo, hash);
+    if (i < 0) i = find(0, hash);   /* PPSSPP's wildcard: any dimension and palette */
+    return i;
+}
+
+const uint8_t *texpack_take(int id, int *w, int *h) {
+    if (id < 0 || id >= g_n) return NULL;
+    tp_entry *e = &g_e[id];
+    if (e->state == 2) { *w = e->w; *h = e->h; return e->px; }
+    if (e->state == 0) {
+        pthread_mutex_lock(&g_mu);
+        if (g_qtail - g_qhead < 1024) { e->state = 1; g_queue[g_qtail++ % 1024] = id; }
+        pthread_mutex_unlock(&g_mu);
+    }
+    return NULL;
+}
+
+void texpack_done(int id) {
+    if (id < 0 || id >= g_n) return;
+    tp_entry *e = &g_e[id];
+    if (e->state == 2) { free(e->px); e->px = NULL; e->state = 3; }
+}
+
+void texpack_reload(int id) {
+    if (id >= 0 && id < g_n && g_e[id].state == 3) g_e[id].state = 0;   /* evicted: decode again when next drawn */
+}
+
+/* ---- preloading (the whole pack at start-up, behind the loading bar) ------------------------- */
+
+int texpack_count(void) { return g_n; }
+
+/* What the decoded-texture cache was made from: every key and file name, and
+ * each textures.ini's size and date. */
+uint64_t texpack_signature(void) {
+    uint64_t h = g_ini_sig ^ (uint64_t)g_n ^ ((uint64_t)g_use_xxh64 << 40);
+    for (int i = 0; i < g_n; i++) {
+        h = (h ^ g_e[i].lo) * 0x100000001B3ull;
+        h = (h ^ g_e[i].hash) * 0x100000001B3ull;
+        for (const char *c = g_e[i].path; *c; c++) h = (h ^ (uint8_t)*c) * 0x100000001B3ull;
+    }
+    return h;
+}
+
+/* The first entry naming the same file as id (keys often share an image). */
+int texpack_canon(int id) {
+    static int *canon;
+    if (id < 0 || id >= g_n) return id;
+    if (!canon) {
+        canon = (int *)malloc((size_t)g_n * sizeof *canon);
+        if (!canon) return id;
+        uint32_t size = 1;
+        while (size < (uint32_t)g_n * 2 + 16) size <<= 1;
+        int *t = (int *)malloc(size * sizeof *t);
+        if (!t) { free(canon); canon = NULL; return id; }
+        for (uint32_t i = 0; i < size; i++) t[i] = -1;
+        for (int i = 0; i < g_n; i++) {
+            uint32_t hsh = 2166136261u;
+            for (const char *c = g_e[i].path; *c; c++) hsh = (hsh ^ (uint8_t)*c) * 16777619u;
+            uint32_t k = hsh & (size - 1);
+            canon[i] = i;
+            while (t[k] >= 0) {
+                if (!strcmp(g_e[t[k]].path, g_e[i].path)) { canon[i] = t[k]; break; }
+                k = (k + 1) & (size - 1);
+            }
+            if (canon[i] == i) t[k] = i;
+        }
+        free(t);
+    }
+    return canon[id];
+}
+
+/* Load and decode id now, on this thread; the caller frees the pixels. */
+uint8_t *texpack_load_now(int id, int *w, int *h) {
+    if (id < 0 || id >= g_n) return NULL;
+    uint8_t *px = load_png(g_e[id].path, w, h);
+    if (px) g_decoded++;
+    else { g_failed++; g_e[id].state = -1; }
+    return px;
+}
+
+void texpack_stats(FILE *out) {
+    if (g_loaded) fprintf(out, "  texpack             %d textures, %lu decoded, %lu failed\n", g_n, g_decoded, g_failed);
+}
