diff --git a/port/switch2/localize_regs.py b/port/switch2/localize_regs.py
new file mode 100644
index 0000000..3b4cdb8
--- /dev/null
+++ b/port/switch2/localize_regs.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Keep the PSP's general registers in host registers (port/gen post-pass).
+
+The recompiler writes every MIPS register access as psp_cpu.r[n] (the r_xx
+macros of recomp_funcs.h): a global the C compiler must load and store around
+every instruction, since any store through a pointer might change it. This
+pass gives each generated function local copies of the registers it uses:
+
+  - loaded from psp_cpu.r at the function's start,
+  - written back and reloaded around every call that can see the registers
+    (other game functions, dispatch, syscalls, the scheduler): `{ SO; call; SI; }`
+    -- in braces, so it stays one statement after a bare `if`,
+  - written back before every `return` and at the end of the function.
+
+Between calls the compiler is then free to keep them in host registers. r_zero
+(never written by the generated code) becomes the constant 0. The FPU, VFPU
+and hi/lo registers are left as they are. Runtime helpers called with register
+values as arguments (psp_lwl, psp_vmul, ...) never read the GPRs themselves
+(checked: only the calls listed in CALL below do), so they need no write-back.
+
+    localize_regs.py <recomp_part_NN.c> <out.c>
+"""
+import re
+import sys
+
+NAMES = ["zero", "at", "v0", "v1", "a0", "a1", "a2", "a3", "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7",
+         "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "t8", "t9", "k0", "k1", "gp", "sp", "fp", "ra"]
+IDX = {n: i for i, n in enumerate(NAMES)}
+REG = re.compile(r"\br_(" + "|".join(NAMES) + r")\b")
+CALL = re.compile(r"\b(psp_(?:func|body|at|import|step|orig)_[0-9A-F]+|psp_dispatch|psp_syscall|psp_park_thread"
+                  r"|psp_scc_drain|psp_scc_step)\(([^;()]*(?:\([^;()]*\))?[^;()]*)\);")
+RET = re.compile(r"\breturn;")
+# an assignment to a register: r_xx = / += / ... (not ==)
+ASSIGN = re.compile(r"\br_(" + "|".join(NAMES) + r")\s*(?:[-+*/%&|^]|<<|>>)?=(?!=)")
+LABEL = re.compile(r"^L_[0-9A-F]+:")
+MAX_CALLS = int(__import__("os").environ.get("LOCALIZE_MAX_CALLS", "2"))
+FUNC_START = re.compile(r"^(?:static )?void \w+\([^)]*\) \{$")
+
+
+def transform(body_lines, out):
+    """body_lines: the function's lines from its opening line to its closing '}'."""
+    used = set()
+    for ln in body_lines:
+        for m in REG.finditer(ln):
+            if m.group(1) != "zero":
+                used.add(m.group(1))
+    ncalls = sum(len(CALL.findall(ln)) for ln in body_lines[1:-1])
+    if not used or ncalls > MAX_CALLS:      # call-heavy functions: the write-backs cost more than they save
+        out.writelines(body_lines)
+        return
+    regs = sorted(used, key=lambda n: IDX[n])
+    # Written back: only registers the function assigns. One it only reads is
+    # never different from psp_cpu (loaded at entry, reloaded after calls).
+    written = set()
+    for ln in body_lines:
+        for m in ASSIGN.finditer(ln):
+            if m.group(1) != "zero":
+                written.add(m.group(1))
+    so = " ".join(f"psp_cpu.r[{IDX[n]}] = l_{n};" for n in regs if n in written)
+    si = " ".join(f"l_{n} = psp_cpu.r[{IDX[n]}];" for n in regs)
+    out.write(body_lines[0])
+    out.write("    uint32_t " + ", ".join(f"l_{n} = psp_cpu.r[{IDX[n]}]" for n in regs) + ";\n")
+    def so_of(dirty):
+        return " ".join(f"psp_cpu.r[{IDX[n]}] = l_{n};" for n in regs if n in dirty)
+
+    # Registers changed since they were last written back, scanning in order.
+    # A label can be reached from anywhere: everything written counts as changed
+    # there. A call clears the set only when it runs unconditionally (the line
+    # starts with it); one under an `if` leaves the other path as it was.
+    dirty = set(written)                       # the switch on _entry jumps to labels anyway
+    for ln in body_lines[1:-1]:
+        st = ln.strip()
+        if LABEL.match(st):
+            dirty = set(written)
+        before_call = CALL.search(ln)
+        # assignments on this line before its first call are pending at that call
+        head = ln[:before_call.start()] if before_call else ln
+        for m in ASSIGN.finditer(head):
+            if m.group(1) != "zero":
+                dirty.add(m.group(1))
+        cur_so = so_of(dirty)
+        new = REG.sub(lambda m: "0u" if m.group(1) == "zero" else "l_" + m.group(1), ln)
+        new = CALL.sub(lambda m: "{ " + cur_so + " " + m.group(0) + " " + si + " }", new)
+        if before_call:
+            uncond = CALL.match(st) is not None or st.startswith("{ uint32_t _spc")
+            tail_dirty = set() if uncond else set(dirty)
+            for m in ASSIGN.finditer(ln[before_call.start():]):
+                if m.group(1) != "zero":
+                    tail_dirty.add(m.group(1))
+            ret_so = so_of(tail_dirty | (set() if uncond else dirty))
+            dirty = tail_dirty
+        else:
+            ret_so = so_of(dirty)
+        new = RET.sub("{ " + ret_so + " return; }" if ret_so else "return;", new)
+        out.write(new)
+    tail = so_of(dirty)
+    if tail:
+        out.write("    " + tail + "\n")
+    out.write(body_lines[-1])
+
+
+def main(src, dst):
+    with open(src, encoding="utf-8", errors="surrogateescape") as f, \
+         open(dst, "w", encoding="utf-8", errors="surrogateescape") as out:
+        body = None
+        for ln in f:
+            if body is None:
+                if FUNC_START.match(ln.rstrip("\n")):
+                    body = [ln]
+                else:
+                    out.write(ln)
+                continue
+            body.append(ln)
+            if ln.rstrip("\n") == "}":
+                transform(body, out)
+                body = None
+        if body:
+            out.writelines(body)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
diff --git a/port/switch2/switch_main.c b/port/switch2/switch_main.c
new file mode 100644
index 0000000..acc3a1d
--- /dev/null
+++ b/port/switch2/switch_main.c
@@ -0,0 +1,1640 @@
+/* PSP2i on Switch 2 under kaiHEN: the libnx host (an NRO).
+ *
+ * Modelled on the SDL3 host (host/sdl_main.c), with SDL replaced by libnx and
+ * EGL, and everything on the main thread:
+ *
+ *   - PSP threads are psprecomp's assembly fibers on this one OS thread
+ *     (threadman.c, PSPRECOMP_ASM_FIBERS), the GE runs inline (no GE thread),
+ *     and every file read happens here. Under kaiHEN the NRO lives inside
+ *     another game's process, where threads of our own that read files were
+ *     unreliable (the Melee port's lesson); none are created.
+ *   - Video: OpenGL 4.x core through EGL on the default NWindow (OunceVK: Mesa
+ *     Zink on NVK); gl_ge.c renders the GE as on Windows (its desktop GL path).
+ *   - Sound: audout at 48 kHz. The PSP's audio channels (44.1 kHz) are mixed
+ *     and resampled here; released audout buffers are refilled from the audio
+ *     sink and from every vblank, without blocking and without a thread.
+ *   - Input: the first controller (handheld or player 1). Face buttons by
+ *     position (B is Cross, A is Circle), L/ZL and R/ZR are L and R, + and -
+ *     are START and SELECT, the right stick turns the camera, R3 opens the
+ *     settings menu, + and - together quit to the homebrew menu.
+ *
+ * Files, in sdmc:/switch/psp2i/ (beside the NRO):
+ *
+ *   *.iso              the game (psp2i.ini iso=<path> to choose another)
+ *   EBOOT.BIN          optional: a decrypted EBOOT when the disc's is encrypted
+ *   GameData/flash/    the PSP fonts (flash/font)
+ *   GameData/ms/       the memory stick (saves), created on first save
+ *   psp2i.ini          settings (the menu's choices are written back)
+ *   logs/              psp2i_log.txt (this run), launches.txt, quit.log
+ */
+
+#include <switch.h>
+#ifndef PSP2I_SOFTWARE_VIDEO
+#include <EGL/egl.h>
+#include <ouncevk/profile.h>
+#include <EGL/eglext.h>
+#endif
+
+#include <psprecomp/cpu.h>
+#include <psprecomp/dispatch.h>
+#include <psprecomp/hle.h>
+#include <psprecomp/mem.h>
+#include <psprecomp/net.h>
+#include <psprecomp/render.h>
+
+#include "atrac_at3.h"
+#include "camera.h"
+#include "framerate.h"
+#include "fastpaths.h"
+#include "h264_static.h"
+#ifndef PSP2I_SOFTWARE_VIDEO
+#include "gl_ge.h"
+#include "texpack.h"
+#include "gl_load.h"
+#endif
+#include "menu.h"
+#include "postfx.h"
+
+#include <dirent.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#ifndef PSP2I_SWITCH_BUILD
+#define PSP2I_SWITCH_BUILD 0
+#endif
+#ifndef PSP2I_SWITCH_VERSION
+#define PSP2I_SWITCH_VERSION "0.9.2"
+#endif
+
+#define BASE "sdmc:/switch/psp2i"     /* the NRO, the ISO, GameData, textures, logs: all in one folder */
+#define SCREEN_W 480
+#define SCREEN_H 272
+#define USER_PARTITION_TOP 0x0A000000u
+
+void psp_recomp_register(void);          /* the generated code (port/gen), or gen_stub.c */
+
+/* ---- logs -------------------------------------------------------------------- */
+
+static int g_logging = 1;                /* psp2i.ini logging=0 turns the log off */
+static volatile const char *g_host_stage = "start";   /* where the host is (hang reports) */
+#ifdef PSP2I_PROFILE
+static volatile int g_prof_reset;                      /* L3: clear the profile */
+#endif
+#ifdef PSP2I_SOFTWARE_VIDEO
+static volatile const char *gl_ge_stage = "software";
+#endif
+
+static void trail(const char *file, const char *fmt, ...) {
+    char path[256];
+    snprintf(path, sizeof path, BASE "/logs/%s", file);
+    FILE *f = fopen(path, "a");
+    if (!f) return;
+    va_list a;
+    va_start(a, fmt);
+    vfprintf(f, fmt, a);
+    va_end(a);
+    fputc('\n', f);
+    fclose(f);
+}
+
+static void now_text(char *out, size_t cap) {
+    const time_t t = time(NULL);
+    struct tm tm;
+    localtime_r(&t, &tm);
+    strftime(out, cap, "%Y-%m-%d %H:%M:%S", &tm);
+}
+
+/* ---- errors before the picture: a text screen, + closes it --------------------- */
+
+static int g_gl_up;
+
+static void fail(const char *msg) {
+    fprintf(stderr, "psp2i: %s\n", msg);
+    trail("quit.log", "build %d: stopped: %s", PSP2I_SWITCH_BUILD, msg);
+    if (g_gl_up) return;                 /* the window belongs to EGL now: the log has it */
+    consoleInit(NULL);
+    printf("\n  Phantasy Star Portable 2 Infinity (Switch 2 Port) %s\n\n", PSP2I_SWITCH_VERSION);
+    printf("  %s\n\n  Press + to return to the homebrew menu.\n", msg);
+    consoleUpdate(NULL);
+    PadState pad;
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    padInitializeDefault(&pad);
+    while (appletMainLoop()) {
+        padUpdate(&pad);
+        if (padGetButtonsDown(&pad) & HidNpadButton_Plus) break;
+        consoleUpdate(NULL);
+        svcSleepThread(16000000);
+    }
+    consoleExit(NULL);
+}
+
+/* ---- the game's ELF ------------------------------------------------------- */
+
+#pragma pack(push, 1)
+typedef struct {
+    uint8_t  ident[16];
+    uint16_t type, machine;
+    uint32_t version, entry, phoff, shoff, flags;
+    uint16_t ehsize, phentsize, phnum, shentsize, shnum, shstrndx;
+} Elf32_Ehdr;
+typedef struct { uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align; } Elf32_Phdr;
+typedef struct { uint32_t name, type, flags, addr, offset, size, link, info, addralign, entsize; } Elf32_Shdr;
+#pragma pack(pop)
+
+typedef struct { uint32_t entry, gp, load_hi; char name[29]; } module_info;
+
+static uint8_t *read_file(const char *path, size_t *len) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    const long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    uint8_t *b = n > 0 ? (uint8_t *)malloc((size_t)n) : NULL;
+    if (b && fread(b, 1, (size_t)n, f) != (size_t)n) { free(b); b = NULL; }
+    fclose(f);
+    if (b) *len = (size_t)n;
+    return b;
+}
+
+static int load_elf_buf(uint8_t *b, size_t len, module_info *mi) {
+    const Elf32_Ehdr *eh = (const Elf32_Ehdr *)b;
+    if (len < sizeof *eh || memcmp(eh->ident, "\x7F" "ELF", 4) != 0 || eh->machine != 8) { free(b); return -2; }
+    memset(mi, 0, sizeof *mi);
+    mi->entry = eh->entry;
+    for (unsigned i = 0; i < eh->phnum; i++) {
+        const Elf32_Phdr *ph = (const Elf32_Phdr *)(b + eh->phoff + i * eh->phentsize);
+        if (ph->type != 1) continue;
+        if ((size_t)ph->offset + ph->filesz > len || psp_mem_write_block(ph->vaddr, b + ph->offset, ph->filesz) != 0) { free(b); return -2; }
+        for (uint32_t a = ph->vaddr + ph->filesz; a < ph->vaddr + ph->memsz; a++) psp_write8(a, 0);
+        if (ph->vaddr + ph->memsz > mi->load_hi) mi->load_hi = ph->vaddr + ph->memsz;
+    }
+    if (eh->shoff && eh->shstrndx < eh->shnum) {
+        const Elf32_Shdr *sh = (const Elf32_Shdr *)(b + eh->shoff);
+        const char *strtab = (const char *)(b + sh[eh->shstrndx].offset);
+        for (unsigned i = 0; i < eh->shnum; i++) {
+            if (strcmp(strtab + sh[i].name, ".rodata.sceModuleInfo") != 0) continue;
+            memcpy(mi->name, b + sh[i].offset + 4, 28);
+            memcpy(&mi->gp, b + sh[i].offset + 32, 4);
+        }
+    }
+    free(b);
+    return mi->gp ? 0 : -2;
+}
+
+/* ---- hooks the generated code calls ------------------------------------- */
+
+void psp_syscall(uint32_t id) {
+    fprintf(stderr, "psp2i: raw syscall 0x%05X reached\n", id);
+    psp_ret(SCE_KERNEL_ERROR_NOTIMPLEMENTED);
+}
+
+void psp_unimplemented(uint32_t addr, const char *what) {
+    static uint32_t seen[256];
+    static int n;
+    for (int i = 0; i < n; i++) if (seen[i] == addr) return;
+    if (n < 256) seen[n++] = addr;
+    fprintf(stderr, "psp2i: untranslated instruction at 0x%08X: %s\n", addr, what ? what : "?");
+}
+
+/* ---- sound: the PSP's channels mixed into audout, no thread ------------------ */
+
+#define AUDIO_CHANNELS 8
+#define IN_RATE   44100
+#define OUT_RATE  48000
+#define OUT_FRAMES 1024                  /* per audout buffer: 21 ms */
+#define OUT_BUFS  4
+#define RING      16384                  /* frames per channel (power of two) */
+#define RING_CAP  (IN_RATE * 15 / 100)   /* more than 150 ms queued: a stall, drop the oldest */
+
+static struct { int16_t s[RING * 2]; uint32_t rd, wr; } g_pring[AUDIO_CHANNELS];
+static int g_audio_on;
+static float g_master = 1.0f;            /* the menu's MASTER VOLUME */
+static AudioOutBuffer g_obuf[OUT_BUFS];
+static int16_t g_omem[OUT_BUFS][OUT_FRAMES * 2] __attribute__((aligned(0x1000)));
+static double g_phase;                   /* position past hist[TAPS/2-1], in input frames */
+static uint64_t g_underruns, g_overflows; /* audout found nothing queued; a queue over RING_CAP dropped */
+static double g_rate_adj = 1.0;          /* the resampler's speed: nudged to keep the queue near its target */
+static double g_queue_avg;               /* queued input frames, smoothed */
+#define QUEUE_TARGET (IN_RATE * 50 / 1000)   /* 50 ms */
+
+/* 44.1 -> 48 kHz with a windowed-sinc filter (32 taps, 512 phases): flat to
+ * about 18 kHz with artefacts 60 dB down, where straight-line interpolation
+ * dulled the treble and added harsh aliasing (17 dB at 9 kHz). */
+#define TAPS   32
+#define PHASES 512
+static float g_sinc[PHASES + 1][TAPS];
+static int32_t g_hist[TAPS][2];          /* the last TAPS mixed input frames, oldest first */
+
+static void sinc_init(void) {
+    const double fc = 0.94;              /* passband edge: 0.94 of the input's Nyquist, 20.7 kHz */
+    for (int p = 0; p <= PHASES; p++) {
+        const double t = (double)p / PHASES;
+        double v[TAPS], sum = 0;
+        for (int k = 0; k < TAPS; k++) {
+            const double x = k - (TAPS / 2 - 1) - t;
+            const double sn = x == 0 ? 1.0 : sin(M_PI * fc * x) / (M_PI * fc * x);
+            const double r = x / (TAPS / 2);
+            const double w = fabs(r) >= 1 ? 0 : 0.42 + 0.5 * cos(M_PI * r) + 0.08 * cos(2 * M_PI * r);   /* Blackman */
+            v[k] = sn * w;
+            sum += v[k];
+        }
+        for (int k = 0; k < TAPS; k++) g_sinc[p][k] = (float)(v[k] / sum);
+    }
+}
+
+/* One mixed 44.1 kHz frame from every channel's queue (silence where empty). */
+static void mix_one(int32_t *l, int32_t *r) {
+    int32_t a = 0, b = 0;
+    for (int c = 0; c < AUDIO_CHANNELS; c++) {
+        if (g_pring[c].rd == g_pring[c].wr) continue;
+        const uint32_t i = g_pring[c].rd & (RING - 1);
+        a += g_pring[c].s[i * 2];
+        b += g_pring[c].s[i * 2 + 1];
+        g_pring[c].rd++;
+    }
+    *l = a; *r = b;
+}
+
+static int16_t clamp16(float v) { return (int16_t)(v < -32768.0f ? -32768 : v > 32767.0f ? 32767 : (int)v); }
+
+static void fill_buffer(AudioOutBuffer *b) {
+    int16_t *out = (int16_t *)b->buffer;
+    const double step = (double)IN_RATE / OUT_RATE;
+    int empty = 1;
+    for (int c = 0; c < AUDIO_CHANNELS && empty; c++) empty = g_pring[c].rd == g_pring[c].wr;
+    if (empty) g_underruns++;
+    {   /* The game's sound arrives at the PSP's pace and leaves at the Switch's; the two clocks
+         * never quite agree, so the queue drifts until it overflows (a skip) or runs dry (a
+         * gap). Instead the resampler runs up to 0.5% fast or slow -- inaudible -- to hold the
+         * queue near 50 ms. */
+        uint32_t q = 0;
+        for (int c = 0; c < AUDIO_CHANNELS; c++) { const uint32_t n = g_pring[c].wr - g_pring[c].rd; if (n > q) q = n; }
+        g_queue_avg += ((double)q - g_queue_avg) * 0.05;
+        double adj = 1.0 + (g_queue_avg - QUEUE_TARGET) / QUEUE_TARGET * 0.005;
+        g_rate_adj = adj < 0.995 ? 0.995 : adj > 1.005 ? 1.005 : adj;
+    }
+    const double step_now = step * g_rate_adj;
+    for (int i = 0; i < OUT_FRAMES; i++) {
+        while (g_phase >= 1.0) {
+            memmove(g_hist[0], g_hist[1], sizeof g_hist - sizeof g_hist[0]);
+            mix_one(&g_hist[TAPS - 1][0], &g_hist[TAPS - 1][1]);
+            g_phase -= 1.0;
+        }
+        const float *h = g_sinc[(int)(g_phase * PHASES + 0.5)];
+        float l = 0, r = 0;
+        for (int k = 0; k < TAPS; k++) { l += h[k] * (float)g_hist[k][0]; r += h[k] * (float)g_hist[k][1]; }
+        out[i * 2]     = clamp16(l * g_master);
+        out[i * 2 + 1] = clamp16(r * g_master);
+        g_phase += step_now;
+    }
+    b->data_size = OUT_FRAMES * 2 * sizeof(int16_t);
+    b->data_offset = 0;
+}
+
+/* Refill whatever audout has finished playing; never waits. */
+static void audio_pump(void) {
+    if (!g_audio_on) return;
+    for (;;) {
+        AudioOutBuffer *released = NULL;
+        u32 count = 0;
+        if (R_FAILED(audoutGetReleasedAudioOutBuffer(&released, &count)) || !released || !count) break;
+        fill_buffer(released);
+        audoutAppendAudioOutBuffer(released);
+    }
+}
+
+static void audio_sink(int ch, const int16_t *pcm, uint32_t frames) {
+    if (ch < 0 || ch >= AUDIO_CHANNELS || !g_audio_on) return;
+    for (uint32_t i = 0; i < frames; i++) {
+        const uint32_t w = g_pring[ch].wr & (RING - 1);
+        g_pring[ch].s[w * 2] = pcm[i * 2];
+        g_pring[ch].s[w * 2 + 1] = pcm[i * 2 + 1];
+        g_pring[ch].wr++;
+    }
+    if (g_pring[ch].wr - g_pring[ch].rd > RING_CAP) { g_pring[ch].rd = g_pring[ch].wr - RING_CAP / 2; g_overflows++; }
+    audio_pump();
+}
+
+static void audio_start(void) {
+    Result rc = audoutInitialize();
+    if (R_FAILED(rc)) { fprintf(stderr, "sound: audout unavailable (0x%x); running silent\n", rc); return; }
+    rc = audoutStartAudioOut();
+    if (R_FAILED(rc)) { fprintf(stderr, "sound: cannot start audout (0x%x); running silent\n", rc); audoutExit(); return; }
+    g_audio_on = 1;
+    sinc_init();
+    for (int i = 0; i < OUT_BUFS; i++) {
+        memset(&g_obuf[i], 0, sizeof g_obuf[i]);
+        g_obuf[i].buffer = g_omem[i];
+        g_obuf[i].buffer_size = sizeof g_omem[i];
+        fill_buffer(&g_obuf[i]);
+        audoutAppendAudioOutBuffer(&g_obuf[i]);
+    }
+    fprintf(stderr, "sound: audout %u Hz, %u channels\n", audoutGetSampleRate(), audoutGetChannelCount());
+}
+
+static void audio_stop(void) {
+    if (!g_audio_on) return;
+    g_audio_on = 0;
+    audoutStopAudioOut();
+    audoutExit();
+}
+
+/* ---- input ------------------------------------------------------------------- */
+
+#define P_SELECT   0x0001u
+#define P_START    0x0008u
+#define P_UP       0x0010u
+#define P_RIGHT    0x0020u
+#define P_DOWN     0x0040u
+#define P_LEFT     0x0080u
+#define P_L        0x0100u
+#define P_R        0x0200u
+#define P_TRIANGLE 0x1000u
+#define P_CIRCLE   0x2000u
+#define P_CROSS    0x4000u
+#define P_SQUARE   0x8000u
+
+static PadState g_pad;
+static int g_swap_oc;                    /* psp2i.ini swap_circle_cross=on */
+static int g_menu_toggle;                /* R3 held */
+static int g_quit_noted;
+
+/* -32767..32767 (up positive) to the PSP's 0..255 (up 0). */
+static uint8_t axis_byte(int v, int flip) {
+    if (flip) v = -v;
+    int b = 128 + v / 256;
+    return (uint8_t)(b < 0 ? 0 : b > 255 ? 255 : b);
+}
+
+/* The Switch's sticks have a round range (a full diagonal is ~0.71 on each
+ * axis); the PSP's reaches the corners, and PSP2i takes a full diagonal's
+ * speed from them. Stretch the circle onto the square: same direction, the
+ * larger axis carries the full deflection. */
+static void circle_to_square(HidAnalogStickState *s) {
+    const float x = (float)s->x, y = (float)s->y;
+    const float ax = fabsf(x), ay = fabsf(y), m = ax > ay ? ax : ay;
+    if (m < 1.0f) return;
+    float r = sqrtf(x * x + y * y);
+    if (r > 32767.0f) r = 32767.0f;
+    const float k = r / m;
+    float nx = x * k, ny = y * k;
+    if (nx > 32767.0f) nx = 32767.0f;
+    if (nx < -32767.0f) nx = -32767.0f;
+    if (ny > 32767.0f) ny = 32767.0f;
+    if (ny < -32767.0f) ny = -32767.0f;
+    s->x = (s32)nx; s->y = (s32)ny;
+}
+
+static uint32_t pad_state(uint8_t *ax, uint8_t *ay, uint8_t *rx, uint8_t *ry) {
+    static const struct { u64 b; uint32_t bit; } MAP[] = {
+        { HidNpadButton_B, P_CROSS }, { HidNpadButton_A, P_CIRCLE },
+        { HidNpadButton_Y, P_SQUARE }, { HidNpadButton_X, P_TRIANGLE },
+        { HidNpadButton_Minus, P_SELECT }, { HidNpadButton_Plus, P_START },
+        { HidNpadButton_L, P_L }, { HidNpadButton_ZL, P_L },
+        { HidNpadButton_R, P_R }, { HidNpadButton_ZR, P_R },
+        { HidNpadButton_Up, P_UP }, { HidNpadButton_Down, P_DOWN },
+        { HidNpadButton_Left, P_LEFT }, { HidNpadButton_Right, P_RIGHT },
+    };
+    padUpdate(&g_pad);
+    const u64 held = padGetButtons(&g_pad);
+    uint32_t bits = 0;
+    for (size_t k = 0; k < sizeof MAP / sizeof MAP[0]; k++) if (held & MAP[k].b) bits |= MAP[k].bit;
+    HidAnalogStickState l = padGetStickPos(&g_pad, 0), r = padGetStickPos(&g_pad, 1);
+    if (abs(l.x) + abs(l.y) > 6000) { circle_to_square(&l); *ax = axis_byte(l.x, 0); *ay = axis_byte(l.y, 1); }
+    if (abs(r.x) + abs(r.y) > 6000) { circle_to_square(&r); *rx = axis_byte(r.x, 0); *ry = axis_byte(r.y, 1); }
+    g_menu_toggle = (held & HidNpadButton_StickR) != 0;
+#ifdef PSP2I_PROFILE
+    if (padGetButtonsDown(&g_pad) & HidNpadButton_StickL) { g_prof_reset = 1; fprintf(stderr, "profile: cleared (L3)\n"); }
+#endif
+    if ((held & HidNpadButton_Plus) && (held & HidNpadButton_Minus) && !g_quit_noted) {
+        g_quit_noted = 1;
+        fprintf(stderr, "psp2i: + and - pressed: quitting\n");
+        psp_request_exit();
+    }
+    if (g_swap_oc && ((bits & P_CIRCLE) != 0) != ((bits & P_CROSS) != 0)) bits ^= P_CIRCLE | P_CROSS;
+    return bits;
+}
+
+#ifndef PSP2I_SOFTWARE_VIDEO
+/* ---- the picture: EGL on the default NWindow --------------------------------- */
+
+static int g_output_h = 1080;            /* psp2i.ini output=720: the old 1280x720 window */
+static EGLDisplay g_dpy = EGL_NO_DISPLAY;
+static EGLSurface g_surf = EGL_NO_SURFACE;
+static EGLContext g_ctx = EGL_NO_CONTEXT;
+
+static int egl_up(void) {
+    g_dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (g_dpy == EGL_NO_DISPLAY || !eglInitialize(g_dpy, NULL, NULL)) { fprintf(stderr, "gl: eglInitialize failed (0x%x)\n", eglGetError()); return -1; }
+    if (!eglBindAPI(EGL_OPENGL_API)) { fprintf(stderr, "gl: eglBindAPI(OpenGL) failed (0x%x)\n", eglGetError()); return -1; }
+    static const EGLint cfg_attr[] = {
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 0, EGL_STENCIL_SIZE, 0,
+        EGL_NONE,
+    };
+    EGLConfig cfg;
+    EGLint n = 0;
+    if (!eglChooseConfig(g_dpy, cfg_attr, &cfg, 1, &n) || n == 0) { fprintf(stderr, "gl: eglChooseConfig failed (0x%x)\n", eglGetError()); return -1; }
+    /* The window at the screen's own 1920x1080 (the Switch 2's panel, and
+     * docked output): at the default 1280x720 a 4x picture was shrunk by 1.5
+     * and then enlarged again by the system, which with nearest filtering
+     * dropped whole rows and columns -- the UI looked uneven and short. */
+    if (g_output_h == 1080) nwindowSetDimensions(nwindowGetDefault(), 1920, 1080);
+    g_surf = eglCreateWindowSurface(g_dpy, cfg, nwindowGetDefault(), NULL);
+    if (g_surf == EGL_NO_SURFACE) { fprintf(stderr, "gl: eglCreateWindowSurface failed (0x%x)\n", eglGetError()); return -1; }
+    static const EGLint versions[][2] = { {4, 6}, {4, 5}, {4, 3}, {3, 3} };
+    for (size_t i = 0; i < sizeof versions / sizeof versions[0] && g_ctx == EGL_NO_CONTEXT; i++) {
+        const EGLint ctx_attr[] = {
+            EGL_CONTEXT_MAJOR_VERSION, versions[i][0], EGL_CONTEXT_MINOR_VERSION, versions[i][1],
+            EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+            EGL_NONE,
+        };
+        g_ctx = eglCreateContext(g_dpy, cfg, EGL_NO_CONTEXT, ctx_attr);
+    }
+    if (g_ctx == EGL_NO_CONTEXT) { fprintf(stderr, "gl: no OpenGL 3.3+ core context (0x%x)\n", eglGetError()); return -1; }
+    if (!eglMakeCurrent(g_dpy, g_surf, g_surf, g_ctx)) { fprintf(stderr, "gl: eglMakeCurrent failed (0x%x)\n", eglGetError()); return -1; }
+    eglSwapInterval(g_dpy, 0);           /* the scheduler paces frames, not the swap */
+    return 0;
+}
+
+static void egl_down(void) {
+    if (g_dpy == EGL_NO_DISPLAY) return;
+    eglMakeCurrent(g_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (g_ctx != EGL_NO_CONTEXT) eglDestroyContext(g_dpy, g_ctx);
+    if (g_surf != EGL_NO_SURFACE) eglDestroySurface(g_dpy, g_surf);
+    eglTerminate(g_dpy);
+    eglReleaseThread();
+    g_dpy = EGL_NO_DISPLAY; g_surf = EGL_NO_SURFACE; g_ctx = EGL_NO_CONTEXT;
+}
+
+static void surface_size(int *w, int *h) {
+    EGLint cw = 1280, ch = 720;
+    eglQuerySurface(g_dpy, g_surf, EGL_WIDTH, &cw);
+    eglQuerySurface(g_dpy, g_surf, EGL_HEIGHT, &ch);
+    *w = cw; *h = ch;
+}
+
+static void *gl_get(const char *name) { return (void *)eglGetProcAddress(name); }
