diff --git a/port/host/h264_static.c b/port/host/h264_static.c
new file mode 100644
index 0000000..4f1759c
--- /dev/null
+++ b/port/host/h264_static.c
@@ -0,0 +1,117 @@
+/* H.264 decoding for sceMpeg movies (psp_mpeg_set_video_codec) through
+ * OpenH264's decoder built from source and linked in (the Switch build:
+ * no DLLs, no downloads). Same decoder calls as h264_openh264.c.
+ *
+ * OpenH264's source is BSD-licensed. Cisco's H.264 patent licence covers only
+ * Cisco's own prebuilt binaries, not a decoder built from source, which is
+ * why the Windows build downloads Cisco's DLL instead; a build with this file
+ * is for personal use until that is settled. */
+
+#include "h264_static.h"
+
+#include <psprecomp/hle.h>
+
+#include <stdio.h>
+#include <string.h>
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
+
+/* Steps logged and flushed at once while the decoder is new on the Switch:
+ * a hang inside OpenH264 then shows where it stopped. */
+static int g_trace = 1;
+#define STEP(...) do { if (g_trace) { fprintf(stderr, "h264: " __VA_ARGS__); fputc('\n', stderr); fflush(stderr); } } while (0)
+
+#ifdef PSP2I_H264_STATIC
+#include <wels/codec_api.h>
+
+static uint64_t now_us(void) {
+#ifdef __SWITCH__
+    return armTicksToNs(armGetSystemTick()) / 1000;
+#else
+    return 0;
+#endif
+}
+static uint64_t g_dec_n, g_dec_us, g_dec_max;   /* per movie: decode calls, total and longest time */
+
+static void *dec_open(void) {
+    ISVCDecoder *d = NULL;
+    STEP("create");
+    if (WelsCreateDecoder(&d) != 0 || !d) { STEP("create failed"); return NULL; }
+    STEP("options");
+    int quiet = WELS_LOG_QUIET;
+    (*d)->SetOption(d, DECODER_OPTION_TRACE_LEVEL, &quiet);
+    SDecodingParam prm;
+    memset(&prm, 0, sizeof prm);
+    prm.sVideoProperty.eVideoBsType = VIDEO_BITSTREAM_AVC;
+    prm.eEcActiveIdc = ERROR_CON_SLICE_MV_COPY_CROSS_IDR_FREEZE_RES_CHANGE;
+    STEP("initialize");
+    if ((*d)->Initialize(d, &prm) != 0) { STEP("initialize failed"); WelsDestroyDecoder(d); return NULL; }
+    STEP("open done");
+    return d;
+}
+
+static int dec_decode(void *h, const uint8_t *au, int size, int64_t pts, psp_video_frame *out) {
+    ISVCDecoder *d = (ISVCDecoder *)h;
+    unsigned char *dst[3] = { NULL, NULL, NULL };
+    SBufferInfo bi;
+    memset(&bi, 0, sizeof bi);
+    bi.uiInBsTimeStamp = (unsigned long long)pts;
+    static int n;
+    if (n < 3) STEP("decode %d (%d bytes)", n, size);
+    const uint64_t t0 = now_us();
+    if (au) (*d)->DecodeFrameNoDelay(d, au, size, dst, &bi);
+    else    (*d)->FlushFrame(d, dst, &bi);          /* pictures held back for reordering */
+    const uint64_t dt = now_us() - t0;
+    g_dec_n++; g_dec_us += dt; if (dt > g_dec_max) g_dec_max = dt;
+    if (n < 3) STEP("decode %d done, picture %d", n, bi.iBufferStatus);
+    n++;
+    if (bi.iBufferStatus != 1 || !dst[0] || !dst[1] || !dst[2]) return 0;
+    out->width = bi.UsrData.sSystemBuffer.iWidth;
+    out->height = bi.UsrData.sSystemBuffer.iHeight;
+    out->ystride = bi.UsrData.sSystemBuffer.iStride[0];
+    out->uvstride = bi.UsrData.sSystemBuffer.iStride[1];
+    out->y = dst[0];
+    out->u = dst[1];
+    out->v = dst[2];
+    out->pts = (int64_t)bi.uiOutYuvTimeStamp;
+    return 1;
+}
+
+static void dec_close(void *h) {
+    ISVCDecoder *d = (ISVCDecoder *)h;
+    STEP("close");
+    if (g_dec_n) fprintf(stderr, "h264: %llu decodes, %.2f ms each on average, longest %.2f ms\n", (unsigned long long)g_dec_n,
+                         g_dec_us / 1000.0 / g_dec_n, g_dec_max / 1000.0);
+    g_dec_n = g_dec_us = g_dec_max = 0;
+    (*d)->Uninitialize(d);
+    WelsDestroyDecoder(d);
+}
+
+static const psp_video_codec CODEC = { "OpenH264 (built in)", dec_open, dec_decode, dec_close };
+
+int h264_static_init(void) {
+#ifdef __SWITCH__
+    u64 total = 0, used = 0;
+    svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+    svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+    STEP("memory: %llu MB used of %llu MB", (unsigned long long)(used >> 20), (unsigned long long)(total >> 20));
+#endif
+    STEP("self-test");                 /* open and close once at start-up */
+    void *d = dec_open();
+    if (!d) { fprintf(stderr, "video: OpenH264 would not start; movies are black\n"); return -1; }
+    dec_close(d);
+    STEP("self-test passed");
+    psp_mpeg_set_video_codec(&CODEC);
+    fprintf(stderr, "video: movies decoded by OpenH264 (built in)\n");
+    return 0;
+}
+
+#else
+
+int h264_static_init(void) {
+    fprintf(stderr, "video: built without an H.264 decoder; movies are black\n");
+    return -1;
+}
+
+#endif
