+/* Custom textures: PPSSPP texture packs (textures.ini + PNGs) -- see texpack.c. */
+#ifndef PSP2I_TEXPACK_H
+#define PSP2I_TEXPACK_H
+#include <stdint.h>
+#include <stdio.h>
+
+int  texpack_load(const char *root);   /* every pack under root; the number of textures (once) */
+int  texpack_xxh64(void);              /* the packs' hash: xxh64 (else xxh32) */
+int  texpack_find(uint32_t key_lo, uint32_t hash);   /* an id, or -1 */
+/* The decoded RGBA of id, or NULL while it is still loading (the first call
+ * queues it). After uploading it, call texpack_done (frees the pixels). */
+const uint8_t *texpack_take(int id, int *w, int *h);
+void texpack_done(int id);
+void texpack_reload(int id);           /* its upload was dropped: load again on next use */
+void texpack_stats(FILE *out);
+int  texpack_count(void);
+uint64_t texpack_signature(void);    /* changes with the packs (keys, file names, ini size/date) */
+int  texpack_canon(int id);            /* the first entry with the same image file */
+uint8_t *texpack_load_now(int id, int *w, int *h);   /* decoded now, on this thread; caller frees */
+void texpack_pump(double budget_ms);  /* load queued PNGs on the calling (game) thread, for about budget_ms */
+#endif
