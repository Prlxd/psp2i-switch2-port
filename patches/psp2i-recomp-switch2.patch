diff --git a/port/host/fastpaths.c b/port/host/fastpaths.c
new file mode 100644
index 0000000..5bf63ba
--- /dev/null
+++ b/port/host/fastpaths.c
@@ -0,0 +1,236 @@
+/* Native versions of hot game library routines, called from the generated
+ * code in place of the recompiled MIPS (see tools/patch_gen.py, which edits
+ * the function's entry wrapper to try these first).
+ *
+ *   0x08DE0C40  sceDeflateDecompress(dst, dsize, src, &next)  (libdeflt,
+ *               linked into the game): the raw DEFLATE decoder used when an
+ *               area or mission is set up. Recompiled, its bit-by-bit
+ *               Huffman loop and unaligned lwl/swl copy took a third of the
+ *               mission start's 100+ ms frames; zlib's inflate does the same
+ *               work an order of magnitude faster.
+ *
+ * Each returns 1 when it handled the call (results in the guest registers
+ * and memory exactly as the original leaves them), or 0 to let the original
+ * run -- every error case goes to the original, so error codes stay its own. */
+
+#include <stdint.h>
+#include <string.h>
+#include <zlib.h>
+
+#include <psprecomp/cpu.h>
+#include <psprecomp/mem.h>
+
+#include "fastpaths.h"
+
+static int g_fast_on = 1;
+static uint64_t g_inflates, g_inflate_bytes;
+
+void fastpaths_set_enabled(int on) { g_fast_on = on != 0; }
+void fastpaths_stats(uint64_t *calls, uint64_t *bytes) { *calls = g_inflates; *bytes = g_inflate_bytes; }
+
+static uint32_t span_to_end(uint32_t addr) {
+    if (addr < PSP_RAM_BASE || addr >= PSP_RAM_BASE + PSP_RAM_SIZE) return 0;
+    return PSP_RAM_BASE + PSP_RAM_SIZE - addr;
+}
+
+int psp2i_fast_deflate_decompress(void) {
+    if (!g_fast_on) return 0;
+    const uint32_t dst = psp_cpu.r[4], dsize = psp_cpu.r[5], src = psp_cpu.r[6], pnext = psp_cpu.r[7];
+    const uint32_t srcmax = span_to_end(src), dstmax = span_to_end(dst);
+    if (!srcmax || !dstmax || dsize == 0 || dsize > dstmax) return 0;
+    uint8_t *d = (uint8_t *)psp_mem_ptr(dst, dsize);
+    const uint8_t *s = (const uint8_t *)psp_mem_ptr(src, srcmax);
+    if (!d || !s) return 0;
+
+    z_stream z;
+    memset(&z, 0, sizeof z);
+    if (inflateInit2(&z, -15) != Z_OK) return 0;
+    z.next_in = (Bytef *)s;
+    z.avail_in = srcmax;
+    z.next_out = d;
+    z.avail_out = dsize;
+    const int r = inflate(&z, Z_FINISH);
+    const uint32_t out = (uint32_t)z.total_out, used = (uint32_t)(z.next_in - (const Bytef *)s);
+    inflateEnd(&z);
+    if (r != Z_STREAM_END) return 0;            /* an error: the original reports it */
+
+    if (pnext) psp_write32(pnext, src + used);
+    psp_cpu.r[2] = out;                          /* $v0: bytes written */
+    g_inflates++;
+    g_inflate_bytes += out;
+    return 1;
+}
+
+/* ---- 0x08B8C5C0 / 0x08B8C6AC: the game backs up 880 KB of VRAM (0x04100000,
+ * 0xDC000 bytes) to RAM at [0x08EDEDB4] + 0x324000 and copies it back. The
+ * recompiled loop reads or writes VRAM one word at a time, each through the
+ * VRAM hook; one mapping and one memcpy do the same. A callback the game may
+ * install afterwards ([0x08EDED94] / [0x08EDED98]) sends the call to the original. */
+#define VSAVE_SIZE 0xDC000u
+static uint32_t g_frame_vsave, g_frame_vrestore, g_frame_prs, g_frame_prs_bytes;
+void fastpaths_frame_counts(uint32_t *vsave, uint32_t *vrestore, uint32_t *prs, uint32_t *prs_bytes) {
+    *vsave = g_frame_vsave; *vrestore = g_frame_vrestore; *prs = g_frame_prs; *prs_bytes = g_frame_prs_bytes;
+    g_frame_vsave = g_frame_vrestore = g_frame_prs = g_frame_prs_bytes = 0;
+}
+
+void psp_func_08B8C68C(void);
+void psp_func_08B8C778(void);
+static int vram_copy(int save) {
+    if (!g_fast_on) return 0;
+    const uint32_t ram = psp_read32(0x08EDEDB4u) + 0x324000u, vram = PSP_VRAM_BASE + 0x100000u;
+    uint8_t *r = (uint8_t *)psp_mem_ptr(ram, VSAVE_SIZE);
+    if (!r) return 0;
+    uint8_t *v = (uint8_t *)psp_mem_ptr(vram, VSAVE_SIZE);   /* the VRAM hook, once */
+    if (!v) return 0;
+    /* 0x08B8C5C0 copies RAM -> VRAM (a restore), 0x08B8C6AC VRAM -> RAM (a save). */
+    if (save) memcpy(r, v, VSAVE_SIZE); else memcpy(v, r, VSAVE_SIZE);
+    if (save) g_frame_vsave++; else g_frame_vrestore++;
+    /* The prologue the original ran, then its own tail (the game's callback
+     * and the epilogue), exactly as the copy loop falls into it. */
+    uint32_t *R = psp_cpu.r;
+    R[29] -= 16;
+    if (!save) {                                              /* 0x08B8C5C0 */
+        psp_write32(R[29], R[31]);
+        R[6] = ram + VSAVE_SIZE; R[7] = vram + VSAVE_SIZE; R[8] = ram + VSAVE_SIZE;
+        R[2] = 0x08EE0000u;
+        psp_func_08B8C68C();
+    } else {                                                  /* 0x08B8C6AC */
+        psp_write32(R[29] + 4, R[31]);
+        psp_write32(R[29], R[16]);
+        R[6] = vram + VSAVE_SIZE; R[7] = vram + VSAVE_SIZE; R[16] = ram + VSAVE_SIZE;
+        R[2] = 0x08EE0000u;
+        psp_func_08B8C778();
+    }
+    return 1;
+}
+int psp2i_fast_vram_restore(void) { return vram_copy(0); }   /* 0x08B8C5C0 */
+int psp2i_fast_vram_save(void) { return vram_copy(1); }      /* 0x08B8C6AC */
+
+/* ---- 0x08D5DEE8 prs_decompress(ctx): Sega's PRS (LZ77) decoder. ctx: [0] src,
+ * [4] src end, [8] next src chunk, [12] its end, [16] dst, [20] end-of-input.
+ * Recompiled it is a cycle of tiny blocks run through the step dispatcher, a
+ * call per bit; this is the same code, branch for branch (delay slots included),
+ * so the output, the ctx updates and $v0 (bytes written) are identical. */
+static inline uint8_t g_rb(uint32_t a) {
+    const uint32_t o = (a & PSP_ADDR_MASK) - PSP_RAM_BASE;
+    return o < PSP_RAM_SIZE ? psp_mem.ram[o] : psp_read8(a);
+}
+static inline void g_wb(uint32_t a, uint8_t v) {
+    const uint32_t o = (a & PSP_ADDR_MASK) - PSP_RAM_BASE;
+    if (o < PSP_RAM_SIZE) psp_mem.ram[o] = v; else psp_write8(a, v);
+}
+static uint32_t prs_refill(uint32_t ctx) {                  /* 0x08D5DEA0 */
+    if (psp_read32(ctx + 20)) return 0;
+    const uint32_t nx = psp_read32(ctx + 8);
+    if (!nx) { psp_write32(ctx + 20, 1); return 0; }
+    psp_write32(ctx + 0, nx);
+    psp_write32(ctx + 4, psp_read32(ctx + 12));
+    psp_write32(ctx + 8, 0);
+    const uint8_t b = g_rb(nx);
+    psp_write32(ctx + 0, nx + 1);
+    return b;
+}
+#define PRS_RB(dst) do { if (a1 < a2) { dst = g_rb(a1); a1++; } \
+                         else { dst = prs_refill(ctx); a1 = psp_read32(ctx); a2 = psp_read32(ctx + 4); } } while (0)
+
+int psp2i_fast_prs(void) {
+    if (!g_fast_on) return 0;
+    const uint32_t ctx = psp_cpu.r[4];
+    if (!psp_mem_ptr(ctx, 24)) return 0;
+    uint32_t s5 = psp_read32(ctx + 16), s6, s4 = 1, a1, a2;
+    int32_t s3 = 0, s1, s2, v0;
+    psp_write32(ctx + 20, 0);
+    s6 = s5;
+    a1 = psp_read32(ctx + 0);
+    a2 = psp_read32(ctx + 4);
+    for (;;) {
+        if (psp_read32(ctx + 20)) break;                      /* DF2C */
+    literal:
+        if (--s4 == 0) { PRS_RB(s3); s4 = 8; }                /* DF38 */
+        {   const int bit = s3 & 1; s3 >>= 1;                 /* DF70 */
+            if (bit) { uint32_t b; PRS_RB(b); g_wb(s5, (uint8_t)b); s5++; goto literal; } }
+        s4--;                                                 /* DFB4 */
+        if (s4 != 0) v0 = s3 & 1;
+        else { PRS_RB(s3); s4 = 8; v0 = s3 & 1; }
+        s3 >>= 1;                                             /* DFF0 */
+        if (v0) {                                             /* long copy */
+            uint32_t b2, b1; PRS_RB(b2); PRS_RB(b1);
+            s2 = (int32_t)b2; s1 = (int32_t)b1;
+            if ((s1 | s2) == 0) break;                        /* E188: the end */
+            v0 = (s1 << 5) + (s2 >> 3);
+            s2 &= 7;
+            s1 = v0 - 8192;
+            if (s2) s2 += 2;
+            else { uint32_t b; PRS_RB(b); s2 = (int32_t)b + 1; }
+        } else {                                              /* E0A0: short copy */
+            s4--;
+            if (s4 != 0) s4--;
+            else { PRS_RB(s3); s4 = 7; }
+            s1 = s3 & 1;                                      /* E0DC */
+            const int more = s4 != 0;
+            s3 >>= 1;
+            if (!more) { PRS_RB(s3); s4 = 8; }
+            s2 = (s1 << 1) + (s3 & 1) + 2;                    /* E114 */
+            s3 >>= 1;
+            uint32_t b; PRS_RB(b);
+            s1 = (int32_t)b - 256;
+        }
+        uint32_t a0 = s5 + (uint32_t)s1;                      /* E154 */
+        const uint32_t a3 = a0 + (uint32_t)s2;
+        while (a0 < a3) { g_wb(s5, g_rb(a0)); a0++; s5++; }
+    }
+    psp_cpu.r[2] = s5 - s6;
+    g_frame_prs++;
+    g_frame_prs_bytes += s5 - s6;
+    return 1;
+}
+
+/* ---- 0x08D65A18 blowfish_decrypt(ctx, buf, len): the game's file decryption,
+ * len/8 blocks in place. ctx: P at +4..+72 (P1..P18), S-boxes at +76, +1100,
+ * +2124, +3148 indexed by the low byte first. Straight-line recompiled code,
+ * but every table lookup is a psp_read32. */
+static uint32_t g_bf_blocks;
+int psp2i_fast_blowfish(void) {
+    if (!g_fast_on) return 0;
+    const uint32_t ctx = psp_cpu.r[4], buf = psp_cpu.r[5];
+    const int32_t len = (int32_t)psp_cpu.r[6];
+    const int32_t n = len / 8;                               /* sra/srl/addu/sra: toward zero */
+    if (n <= 0) return 1;                                    /* blez: straight to jr $ra */
+    const uint32_t *c = (const uint32_t *)psp_mem_ptr(ctx, 4172);
+    uint32_t *b = (uint32_t *)psp_mem_ptr(buf, (uint32_t)n * 8u);
+    if (!c || !b || ((ctx | buf) & 3)) return 0;
+    const uint32_t *P = c, *S0 = c + 19, *S1 = c + 275, *S2 = c + 531, *S3 = c + 787;
+#define BF_F(x) ((((S0[(x) & 0xFF] + S1[((x) >> 8) & 0xFF]) ^ S2[((x) >> 16) & 0xFF]) + S3[(x) >> 24]))
+    for (int32_t i = 0; i < n; i++, b += 2) {
+        uint32_t L = b[0] ^ P[18], R = b[1];
+        for (int k = 17; k >= 2; k -= 2) {
+            R ^= BF_F(L) ^ P[k];
+            L ^= BF_F(R) ^ P[k - 1];
+        }
+        R ^= P[1];
+        b[0] = R; b[1] = L;
+    }
+#undef BF_F
+    psp_cpu.r[11] = buf + (uint32_t)n * 8u;                  /* $t3 */
+    psp_cpu.r[12] = 0;                                       /* $t4 */
+    psp_cpu.r[10] = ctx;                                     /* $t2 */
+    g_bf_blocks += (uint32_t)n;
+    return 1;
+}
+
+/* ---- 0x08A46A50 move_toward(obj, pos, out, out2, $f12 = step): moves `pos`
+ * toward the object's target point (+644) by at most $f12 a frame. The dodge
+ * roll (state 29, 0x08A4C674) and two similar actions pass a constant step
+ * meant for 30 fps, so at 60 the roll's opening lunge covered its distance
+ * twice as fast and then stood still until the roll's own movement took over
+ * (2.5 a frame for 3 frames, 0 for 3: the "snap" at the start of every roll).
+ * Their steps are scaled by 30/fps (the timing state's +0x18): exact at 30,
+ * time-correct at 60 and 120. The caller at 0x08A43420 already divides its
+ * speed by fps and is left alone, as is 0x08A43104 (a computed step). */
+void psp2i_fix_approach_speed(void) {
+    const uint32_t ra = psp_cpu.r[31];
+    if (ra != 0x08A4C7B0u && ra != 0x08A4C824u && ra != 0x08A465D8u && ra != 0x08A4D2B0u) return;
+    const uint32_t w = psp_read32(0x08EDA564u);          /* 30 / fps */
+    float k; memcpy(&k, &w, 4);
+    if (k > 0.0f && k < 1.0f) psp_cpu.f[12] *= k;
+}
