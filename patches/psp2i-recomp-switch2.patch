+/* The cache read in: 1 when it matched and every image came in. */
+static int cus_from_cache(const char *cache_path, uint64_t sig, void (*bar)(double), int *images) {
+    const int n = g_cus_n;
+    FILE *f = fopen(cache_path, "rb");
+    if (!f) return 0;
+    setvbuf(f, NULL, _IOFBF, 4u << 20);
+    uint32_t hdr[2]; uint64_t fsig = 0; int32_t fn = 0;
+    if (fread(hdr, 4, 2, f) != 2 || hdr[0] != CUS_CACHE_MAGIC || fread(&fsig, 8, 1, f) != 1 || fread(&fn, 4, 1, f) != 1
+        || fsig != sig || fn != n) {
+        fclose(f);
+        fprintf(stderr, "custom textures: the cache is from another pack; making it again\n");
+        return 0;
+    }
+    cus_cache_ent *ent = (cus_cache_ent *)malloc((size_t)n * sizeof *ent);
+    if (!ent || fread(ent, sizeof *ent, (size_t)n, f) != (size_t)n) { free(ent); fclose(f); return 0; }
+    size_t cap = 0; uint8_t *buf = NULL;
+    struct timespec tl; clock_gettime(CLOCK_MONOTONIC, &tl);
+    int ok = 1;
+    for (int id = 0; id < n && ok; id++) {
+        const int c = ent[id].canon;
+        if (c < 0 || c > id) { ok = 0; break; }
+        if (c != id) {
+            if (g_cus_tex[c]) { g_cus_tex[id] = g_cus_tex[c]; g_cus_w[id] = g_cus_w[c]; g_cus_h[id] = g_cus_h[c]; }
+            continue;
+        }
+        const int w = ent[id].w, h = ent[id].h;
+        if (w <= 0 || h <= 0) continue;                  /* its file is missing */
+        const size_t bytes = (size_t)w * (size_t)h * 4;
+        if (bytes > cap) { free(buf); cap = bytes; buf = (uint8_t *)malloc(cap); if (!buf) { ok = 0; break; } }
+        if (fread(buf, 1, bytes, f) != bytes) { ok = 0; break; }
+        cus_put(id, cus_upload(buf, w, h), w, h);
+        (*images)++;
+        if (bar && cus_secs(&tl) > 0.033) { glFinish(); bar((double)(id + 1) / n); clock_gettime(CLOCK_MONOTONIC, &tl); }
+    }
+    free(buf); free(ent); fclose(f);
+    if (!ok) fprintf(stderr, "custom textures: the cache could not be read to the end; the rest loads as it is drawn\n");
+    return ok;
+}
+
+void gl_ge_preload_custom_textures(void (*bar)(double), const char *cache_path) {
+    if (!g_cus_tex || g_cus_preloaded) return;
+    const int n = g_cus_n;
+    const uint64_t sig = texpack_signature();
+    struct timespec t0; clock_gettime(CLOCK_MONOTONIC, &t0);
+    int images = 0;
+    if (cache_path && cus_from_cache(cache_path, sig, bar, &images)) {
+        glFinish();
+        if (bar) bar(1.0);
+        g_cus_preloaded = 1;
+        fprintf(stderr, "custom textures: %d images from the cache for %d keys, %llu MB on the GPU, in %.1f s\n",
+                images, n, (unsigned long long)(g_cus_bytes >> 20), cus_secs(&t0));
+        fflush(stderr);
+        return;
+    }
+    if (images) {                                        /* a cache that broke off: what it gave stays, the rest loads on use */
+        fflush(stderr);
+        return;
+    }
+
+    /* From the PNGs, writing the cache as it goes: the header and the table
+     * (filled in at the end), then each image's pixels in id order. */
+    char tmp[512];
+    FILE *out = NULL;
+    cus_cache_ent *ent = (cus_cache_ent *)calloc((size_t)n, sizeof *ent);
+    if (cache_path && ent) {
+        snprintf(tmp, sizeof tmp, "%s.tmp", cache_path);
+        out = fopen(tmp, "wb");
+        if (out) {
+            setvbuf(out, NULL, _IOFBF, 4u << 20);
+            const uint32_t hdr[2] = { CUS_CACHE_MAGIC, 0 };
+            const int32_t n32 = n;
+            if (fwrite(hdr, 4, 2, out) != 2 || fwrite(&sig, 8, 1, out) != 1 || fwrite(&n32, 4, 1, out) != 1
+                || fwrite(ent, sizeof *ent, (size_t)n, out) != (size_t)n) { fclose(out); out = NULL; remove(tmp); }
+        }
+    }
+    struct timespec tl; clock_gettime(CLOCK_MONOTONIC, &tl);
+    int failed = 0;
+    for (int id = 0; id < n; id++) {
+        const int c = texpack_canon(id);
+        if (ent) ent[id].canon = c;
+        if (c != id) {                                   /* the same image as an earlier key */
+            if (g_cus_tex[c]) { g_cus_tex[id] = g_cus_tex[c]; g_cus_w[id] = g_cus_w[c]; g_cus_h[id] = g_cus_h[c]; }
+            continue;
+        }
+        int w = 0, h = 0;
+        uint8_t *px = texpack_load_now(id, &w, &h);
+        if (!px) { failed++; continue; }
+        cus_put(id, cus_upload(px, w, h), w, h);
+        if (out) {
+            if (fwrite(px, 1, (size_t)w * (size_t)h * 4, out) == (size_t)w * (size_t)h * 4) { ent[id].w = w; ent[id].h = h; }
+            else { fclose(out); out = NULL; remove(tmp); fprintf(stderr, "custom textures: the cache could not be written (SD card full?)\n"); }
+        }
+        free(px);
+        images++;
+        if (bar && cus_secs(&tl) > 0.033) { glFinish(); bar((double)(id + 1) / n); clock_gettime(CLOCK_MONOTONIC, &tl); }
+    }
+    glFinish();
+    if (bar) bar(1.0);
+    g_cus_preloaded = 1;
+    if (out) {                                           /* the table, then the finished file in place of the old one */
+        const int good = fseek(out, 20, SEEK_SET) == 0   /* past magic, version, signature, count */ && fwrite(ent, sizeof *ent, (size_t)n, out) == (size_t)n;
+        if (fclose(out) == 0 && good) {
+            remove(cache_path);
+            if (rename(tmp, cache_path) == 0) fprintf(stderr, "custom textures: cache written (%s)\n", cache_path);
+            else remove(tmp);
+        } else remove(tmp);
+    }
+    free(ent);
+    fprintf(stderr, "custom textures: preloaded %d images (%d missing) for %d keys, %llu MB on the GPU, in %.1f s\n",
+            images, failed, n, (unsigned long long)(g_cus_bytes >> 20), cus_secs(&t0));
+    fflush(stderr);
+}
