+/* The replacement for e, uploaded, or NULL (none, or still loading: the
+ * game's own texture is drawn meanwhile). */
+static tex_entry *custom_for(tex_entry *e) {
+    if (!g_custom || !e) return NULL;
+    if (e->rep == -2) {
+        uint32_t lo, h;
+        e->rep = psp_gpu_pack_key(&lo, &h, texpack_xxh64()) ? texpack_find(lo, h) : -1;
+    }
+    const int id = e->rep;
+    if (id < 0 || id >= g_cus_n) return NULL;
+    if (!g_cus_tex[id]) {
+        if (g_cus_preloaded) return NULL;                /* its image is missing */
+        const uint64_t f = frame_no();
+        if (f != g_cus_frame) { g_cus_frame = f; g_cus_frame_uploads = 0; }
+        if (g_cus_frame_uploads >= CUS_UPLOADS_PER_FRAME) return NULL;
+        int w = 0, h = 0;
+        const uint8_t *px = texpack_take(id, &w, &h);
+        if (!px) return NULL;
+        g_cus_frame_uploads++;
+        GLuint t = new_texture((uint32_t)w, (uint32_t)h);
+        glBindTexture(GL_TEXTURE_2D, t);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px);
+        glGenerateMipmap(GL_TEXTURE_2D);
+        if (t < MIP_NAMES) g_mipped[t] = 1;
+        texpack_done(id);
+        g_cus_tex[id] = t; g_cus_w[id] = (uint32_t)w; g_cus_h[id] = (uint32_t)h;
+        g_cus_bytes += (uint64_t)w * h * 4 * 4 / 3;
+        n_cus_uploads++;
+        g_cus_use[id] = ++g_use;
+        cus_evict();
+        if (!g_cus_tex[id]) return NULL;
+    }
+    g_cus_use[id] = ++g_use;
+    n_cus_draws++;
+    static tex_entry r;
+    r.tex = g_cus_tex[id]; r.w = g_cus_w[id]; r.h = g_cus_h[id];
+    return &r;
+}
