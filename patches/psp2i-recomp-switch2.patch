+static void cus_evict(void) {
+    if (g_cus_preloaded) return;
+    while (g_cus_bytes > CUS_BUDGET) {
+        int victim = -1;
+        for (int i = 0; i < g_cus_n; i++)
+            if (g_cus_tex[i] && (victim < 0 || g_cus_use[i] < g_cus_use[victim])) victim = i;
+        if (victim < 0) break;
+        glDeleteTextures(1, &g_cus_tex[victim]);
+        g_cus_tex[victim] = 0;
+        g_cus_bytes -= (uint64_t)g_cus_w[victim] * g_cus_h[victim] * 4 * 4 / 3;
+        texpack_reload(victim);
+    }
+}
