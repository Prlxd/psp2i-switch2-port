+static uint32_t g_frame[SCREEN_W * SCREEN_H];
+static int g_have_frame;
+static uint64_t g_swaps;
+static uint64_t g_t_present, g_t_swap, g_t_last, g_t_wall;   /* ns, for the alive line */
+static uint64_t now_ns(void) { return armTicksToNs(armGetSystemTick()); }
+
+/* The displayed frame from emulated VRAM (videos, and frames the GPU did not
+ * draw). One mapping of the whole frame -- each psp_read16 was a trip through
+ * the renderer's VRAM hook, 130,000 a frame, 3-9 ms of every present during a
+ * movie -- and 16-bit pixels through a table. */
+static int grab_frame(uint32_t addr, uint32_t stride, uint32_t fmt) {
+    static uint32_t lut[3][65536];
+    static int lut_ready;
+    if (!lut_ready) {
+        for (uint32_t p = 0; p < 65536; p++) {
+            lut[0][p] = 0xFF000000u | ((p & 0x1F) * 255 / 31) << 16 | (((p >> 5) & 0x3F) * 255 / 63) << 8 | ((p >> 11) & 0x1F) * 255 / 31;
+            lut[1][p] = 0xFF000000u | ((p & 0x1F) * 255 / 31) << 16 | (((p >> 5) & 0x1F) * 255 / 31) << 8 | ((p >> 10) & 0x1F) * 255 / 31;
+            lut[2][p] = 0xFF000000u | ((p & 0xF) * 17) << 16 | (((p >> 4) & 0xF) * 17) << 8 | ((p >> 8) & 0xF) * 17;
+        }
+        lut_ready = 1;
+    }
+    const int bpp = fmt == 3 ? 4 : 2;
+    const uint8_t *base = (const uint8_t *)psp_mem_ptr(addr, (uint32_t)(((SCREEN_H - 1) * (int)stride + SCREEN_W) * bpp));
+    if (!base) return 0;
+    for (int y = 0; y < SCREEN_H; y++) {
+        uint32_t *o = g_frame + y * SCREEN_W;
+        if (bpp == 4) {
+            const uint8_t *r = base + (size_t)y * stride * 4;
+            for (int x = 0; x < SCREEN_W; x++, r += 4) o[x] = 0xFF000000u | (uint32_t)r[0] << 16 | (uint32_t)r[1] << 8 | r[2];
+        } else {
+            const uint8_t *r = base + (size_t)y * stride * 2;
+            const uint32_t *l = lut[fmt > 2 ? 0 : fmt];
+            for (int x = 0; x < SCREEN_W; x++) o[x] = l[r[2 * x] | r[2 * x + 1] << 8];
+        }
+    }
+    return 1;
+}
+
+#ifndef PSP2I_SOFTWARE_VIDEO
+static void present_now(void) {
+    uint32_t addr, stride, fmt;
+    psp_display_get(&addr, &stride, &fmt);
+    int cw = 0, ch = 0;
+    surface_size(&cw, &ch);
+    if (cw <= 0 || ch <= 0) return;
+    int vw = cw, vh = cw * SCREEN_H / SCREEN_W;           /* the largest 480:272 rectangle, centred */
+    if (vh > ch) { vh = ch; vw = ch * SCREEN_W / SCREEN_H; }
+    if (!(addr && gl_ge_present_direct(addr, stride, (int)fmt, SCREEN_W, SCREEN_H,
+                                       (cw - vw) / 2, (ch - vh) / 2, vw, vh, cw, ch))) {
+        const int p = addr ? gl_ge_present(addr, stride, (int)fmt, g_frame, SCREEN_W, SCREEN_H) : 0;
+        if (p == 1) g_have_frame = 1;
+        else if (p == 0 && addr) g_have_frame = grab_frame(addr, stride, fmt);
+        if (!g_have_frame) memset(g_frame, 0, sizeof g_frame);
+        gl_blit_frame(g_frame, SCREEN_W, SCREEN_H, (cw - vw) / 2, (ch - vh) / 2, vw, vh, cw, ch);
+    }
+    g_vx = (cw - vw) / 2; g_vy = (ch - vh) / 2; g_vw = vw; g_vh = vh;
+    draw_fps(g_vx, g_vy, vw, cw, ch);
+    draw_menu(cw, ch);
+    const uint64_t t_swap = now_ns();
+    g_host_stage = "vblank: eglSwapBuffers";
+    psp_ge_job_done_with_memory();             /* the swap waits for the display, not for PSP memory */
+    eglSwapBuffers(g_dpy, g_surf);
+    g_t_swap += now_ns() - t_swap;
+    if (g_swaps++ == 0) fprintf(stderr, "gl: first frame reached the screen\n");
+}
+
+/* With the GE thread the context lives there: the frame is drawn and swapped
+ * as a job after the lists handed to it, without waiting. A vblank whose
+ * previous frame is still queued skips its own (the GE thread is behind). */
+static volatile int g_present_queued;
+static uint64_t g_present_skipped;
+static uint64_t g_present_max;
+static void present_job(void *arg) {
+    (void)arg;
+    /* The game need not wait for a present: it only reads what is displayed, and the
+     * game writes the other buffer (a movie's CSC into the back buffer each frame). */
+    psp_ge_job_done_with_memory();
+    const uint64_t t0 = now_ns();
+    present_now();
+    const uint64_t dt = now_ns() - t0;
+    g_t_present += dt;
+    if (dt > g_present_max) g_present_max = dt;
+    g_present_queued = 0;
+}
+static void present(void) {
+    if (!psp_ge_threaded()) { const uint64_t t0 = now_ns(); present_now(); g_t_present += now_ns() - t0; return; }
+    if (g_present_queued) { g_present_skipped++; return; }
+    g_present_queued = 1;
+    psp_ge_call(present_job, NULL, 0);
+}
+
+static void ge_ctx_take(void) {
+    if (!eglMakeCurrent(g_dpy, g_surf, g_surf, g_ctx)) fprintf(stderr, "gl: the GE thread could not take the context (0x%x)\n", eglGetError());
+}
+static void ge_ctx_release(void) { eglMakeCurrent(g_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT); }
+
+#else
+static uint64_t g_present_skipped, g_present_max;
+static void present_sw(void);
+static void present(void) { const uint64_t t0 = now_ns(); present_sw(); g_t_present += now_ns() - t0; }
+static void present_sw(void) {
+    uint32_t addr, stride, fmt;
+    psp_display_get(&addr, &stride, &fmt);
+    if (addr) grab_frame(addr, stride, fmt);
+    menu_image img = { g_frame, SCREEN_W, SCREEN_H };
+    if (g_menu.open) menu_draw(&g_menu, &img, framerate_game_fps(), "R3");
+    if (g_fps_on) {
+        fps_meter_sample(&g_fm, armTicksToNs(armGetSystemTick()) / 1000u, psp_display_flips());
+        char line[16];
+        const double v = fps_meter_value(&g_fm);
+        if (v < 0) snprintf(line, sizeof line, "FPS --.-"); else snprintf(line, sizeof line, "FPS %4.1f", v);
+        for (int y = 0; y < 11; y++) for (int x = 0; x < 64; x++) g_frame[y * SCREEN_W + x] = 0xFF000000u;
+        menu_text(&img, 2, 2, line, 0xFFFFFF);
+    }
+    u32 pitch = 0;
+    uint32_t *fb = (uint32_t *)framebufferBegin(&g_fb, &pitch);
+    const int vh = FB_H, vw = FB_H * SCREEN_W / SCREEN_H, x0 = (FB_W - vw) / 2;
+    static int xs[FB_W];
+    static int ready;
+    if (!ready) { for (int x = 0; x < vw; x++) xs[x] = x * SCREEN_W / vw; ready = 1; }
+    for (int y = 0; y < vh; y++) {
+        uint32_t *row = fb + (size_t)y * (pitch / 4);
+        const uint32_t *src = g_frame + (y * SCREEN_H / vh) * SCREEN_W;
+        for (int x = 0; x < x0; x++) row[x] = 0xFF000000u;
+        for (int x = 0; x < vw; x++) {
+            const uint32_t p = src[xs[x]];                /* 0xAARRGGBB -> RGBA8888 in memory (ABGR word) */
+            row[x0 + x] = 0xFF000000u | (p & 0xFF) << 16 | (p & 0xFF00) | (p >> 16 & 0xFF);
+        }
+        for (int x = x0 + vw; x < FB_W; x++) row[x] = 0xFF000000u;
+    }
+    framebufferEnd(&g_fb);
+    if (g_swaps++ == 0) fprintf(stderr, "video: first frame reached the screen (software)\n");
+}
+
+#endif
+
+/* ---- settings ------------------------------------------------------------------- */
+
+static char g_iso_path[512];
+static int  g_tex_nearest = 0;           /* psp2i.ini texture_filter=nearest: no bilinear on game textures */
+static int  g_screen_filter = PF_NEAREST; /* psp2i.ini screen_filter=: nearest by default (bilinear: the 4x picture shrunk smoothly) */
+static int  g_fxaa = 0;                  /* psp2i.ini fxaa=on */
+static int  g_ge_thread = 1;             /* psp2i.ini ge_thread=off: OpenGL on the game's thread */
+static int  g_preempt = 1;               /* psp2i.ini preempt=0: no preemption inside game code */
+static int  g_preload = 1;               /* psp2i.ini preload=0: read the disc image from the SD card as the game asks */
+static int  g_vblank60 = 1;              /* psp2i.ini vblank60=0: the PSP's 59.94 Hz refresh */
+static int  g_fastpaths = 1;             /* psp2i.ini fastpaths=0: the game's own decompressor, recompiled */
+static int  g_fast_load = 0;             /* psp2i.ini fast_load=1: framerate.c's loading speed-ups (hung DLC saves) */
+static int  g_scale = 4;                 /* psp2i.ini scale=1..4: internal resolution (5x+ dips in effects) */
+static float g_rs_speed = 1.0f;
+static int  g_rs_on = 1;
+static int  g_vol[VOL_N] = { VOL_STEPS, VOL_STEPS, VOL_STEPS };
+
+static int pct_step(const char *s) {
+    const int v = (atoi(s) + 5) / 10;
+    return v < 0 ? 0 : v > VOL_STEPS ? VOL_STEPS : v;
+}
+
+static uint64_t g_vblanks;               /* vblanks so far */
+static uint64_t g_log_flush_until;      /* the log flushed every vblank until this one (for a while after a menu change) */
+static int  g_fog = 0;                   /* psp2i.ini fog=on/off (menu FOG) */
+static int  g_custom_tex;                /* psp2i.ini custom_textures=on/off: PPSSPP texture packs in psp2i/textures/ */
+static int  g_mipmaps = 1;               /* psp2i.ini mipmaps=on/off: mip chains for game textures (no shimmer at a distance) */
+static int  g_aniso = 2;                   /* psp2i.ini aniso=0..4 (off, 2x, 4x, 8x, 16x; menu ANISOTROPIC) */
+static int  g_draw_dist = 1;               /* psp2i.ini draw_distance=normal/far/max (menu DRAW DISTANCE): 0, 1, 2 */
+
+/* Once per vblank: the DRAW DISTANCE switch (port/switches.txt): FAR sets
+ * switch 0, the far distances only. Switch 1 (the search radius and no
+ * per-object limits: every object of the area) is left off -- it cost the
+ * Switch 30 fps looking across a mission area. The cheat
+ * code it comes from is reported to corrupt the UI while saving, so it stays
+ * off while the savedata utility runs and 3 s after. */
+static void draw_dist_apply(void) {
+    static uint64_t quiet_until;
+    const uint64_t now = psp_sched_now_us();
+    if (psp_utility_savedata_busy()) quiet_until = now + 3000000u;
+    const int lvl = now >= quiet_until ? g_draw_dist : 0;
+    const uint8_t s0 = lvl >= 1, s1 = 0;
+    if (psp_switch[0] != s0 || psp_switch[1] != s1) {
+        psp_switch[0] = s0;
+        psp_switch[1] = s1;
+        fprintf(stderr, "graphics: draw distance %s%s\n", lvl == 2 ? "max" : lvl ? "far" : "normal",
+                g_draw_dist && !lvl ? " (saving)" : "");
+    }
+}
+
+/* The menu's post-processing to the renderer. FXAA here runs on the 3D only
+ * (gl_ge_set_aa3d), so the HUD keeps its pixels; the present's own FXAA,
+ * which smooths everything, stays off. */
+static void post_apply(void) {
+    postfx p = g_menu.post;
+    gl_ge_set_aa3d(0);                  /* no anti-aliasing on the Switch: it cost too much at 4x */
+    p.fxaa = 0;
+    postfx_set(&p);
+}
+
+static void read_ini(int *fps) {
+    char line[600];
+    FILE *f = fopen(BASE "/psp2i.ini", "r");
+    if (!f) return;
+    while (fgets(line, sizeof line, f)) {
+        line[strcspn(line, "\r\n")] = '\0';
+        if (!strncmp(line, "fps=", 4)) *fps = atoi(line + 4) >= 60 ? 60 : 30;
+        else if (!strncmp(line, "fps_counter=", 12)) g_fps_on = !strncmp(line + 12, "on", 2);
+        else if (!strncmp(line, "swap_circle_cross=", 18)) g_swap_oc = !strncmp(line + 18, "on", 2);
+        else if (!strncmp(line, "iso=", 4)) snprintf(g_iso_path, sizeof g_iso_path, "%s", line + 4);
+        else if (!strncmp(line, "rs_speed=", 9)) g_rs_speed = (float)atof(line + 9);
+        else if (!strncmp(line, "right_stick=", 12)) g_rs_on = strncmp(line + 12, "off", 3) != 0;
+        else if (!strncmp(line, "volume_master=", 14)) g_vol[VOL_MASTER] = pct_step(line + 14);
+        else if (!strncmp(line, "volume_music=", 13)) g_vol[VOL_MUSIC] = pct_step(line + 13);
+        else if (!strncmp(line, "volume_sfx=", 11)) g_vol[VOL_SFX] = pct_step(line + 11);
+        else if (!strncmp(line, "logging=", 8)) g_logging = atoi(line + 8) != 0;
+        else if (!strncmp(line, "adaptive=", 9)) { framerate_set_adaptive(atoi(line + 9) != 0);
+                                                    if (!atoi(line + 9)) fprintf(stderr, "framerate: adaptive stepping off (psp2i.ini adaptive=0)\n"); }
+        else if (!strncmp(line, "fog=", 4)) g_fog = strncmp(line + 4, "off", 3) != 0;
+        else if (!strncmp(line, "custom_textures=", 16)) g_custom_tex = !strncmp(line + 16, "on", 2) || line[16] == '1';
+        else if (!strncmp(line, "mipmaps=", 8)) g_mipmaps = !(line[8] == '0' || !strncmp(line + 8, "off", 3));
+        else if (!strncmp(line, "aniso=", 6)) { g_aniso = atoi(line + 6); if (g_aniso < 0) g_aniso = 0; if (g_aniso > 4) g_aniso = 4; }
+        else if (!strncmp(line, "draw_distance=", 14)) g_draw_dist = !strncmp(line + 14, "far", 3) || !strncmp(line + 14, "max", 3);
+        else if (!strncmp(line, "texture_filter=", 15)) g_tex_nearest = !strncmp(line + 15, "nearest", 7);
+        else if (!strncmp(line, "screen_filter=", 14)) {
+            const char *v = line + 14;
+            g_screen_filter = !strncmp(v, "nearest", 7) ? PF_NEAREST : !strncmp(v, "sharp", 5) ? PF_SHARP_BILINEAR : PF_BILINEAR;
+        }
+        else if (!strncmp(line, "fxaa=", 5)) g_fxaa = !strncmp(line + 5, "on", 2);
+        else if (!strncmp(line, "ge_thread=", 10)) g_ge_thread = strncmp(line + 10, "off", 3) != 0;
+        else if (!strncmp(line, "fast_load=", 10)) g_fast_load = atoi(line + 10) != 0;
+        else if (!strncmp(line, "preempt=", 8)) g_preempt = atoi(line + 8) != 0;
+        else if (!strncmp(line, "preload=", 8)) g_preload = atoi(line + 8) != 0;
+        else if (!strncmp(line, "vblank60=", 9)) g_vblank60 = atoi(line + 9) != 0;
+        else if (!strncmp(line, "fastpaths=", 10)) g_fastpaths = atoi(line + 10) != 0;
+        else if (!strncmp(line, "output=", 7)) g_output_h = atoi(line + 7) == 720 ? 720 : 1080;
+        else if (!strncmp(line, "scale=", 6)) { g_scale = atoi(line + 6); if (g_scale < 1) g_scale = 1; if (g_scale > 4) g_scale = 4; }
+        else if (!strncmp(line, "fogtest=", 8)) gl_ge_set_fog_test(atoi(line + 8));
+    }
+    fclose(f);
+}
+
+static void audio_apply(void) {
+    g_master = (float)g_menu.vol[VOL_MASTER] / VOL_STEPS;
+    atrac_at3_set_gain((float)g_menu.vol[VOL_MUSIC] / VOL_STEPS);
+    psp_sas_set_gain((float)g_menu.vol[VOL_SFX] / VOL_STEPS);
+}
+
+/* psp2i.ini with the menu's keys rewritten; other lines (iso=, logging=, comments) kept. */
+static void write_ini(void) {
+    static const char *const OURS[] = { "fps=", "fps_counter=", "right_stick=", "rs_speed=", "volume_master=",
+                                        "volume_music=", "volume_sfx=", "swap_circle_cross=", "screen_filter=", "fxaa=", "scale=",
+                                        "fog=", "aniso=", "draw_distance=", "mipmaps=", "custom_textures=" };
+    char line[600];
+    FILE *out = fopen(BASE "/psp2i.ini.new", "w");
+    if (!out) { fprintf(stderr, "menu: cannot write psp2i.ini\n"); return; }
+    FILE *in = fopen(BASE "/psp2i.ini", "r");
+    if (in) {
+        while (fgets(line, sizeof line, in)) {
+            int ours = 0;
+            for (size_t k = 0; k < sizeof OURS / sizeof OURS[0] && !ours; k++) ours = !strncmp(line, OURS[k], strlen(OURS[k]));
+            if (ours || !line[0]) continue;
+            fputs(line, out);
+            if (line[strlen(line) - 1] != '\n') fputc('\n', out);
+        }
+        fclose(in);
+    }
+    fprintf(out, "fps=%d\nfps_counter=%s\nright_stick=%s\nrs_speed=%.2f\n", g_menu.fps, g_menu.show_fps ? "on" : "off",
+            g_menu.rs_on ? "on" : "off", (double)menu_rs_speed(&g_menu));
+    fprintf(out, "volume_master=%d\nvolume_music=%d\nvolume_sfx=%d\n", g_menu.vol[VOL_MASTER] * 10, g_menu.vol[VOL_MUSIC] * 10,
+            g_menu.vol[VOL_SFX] * 10);
+    fprintf(out, "swap_circle_cross=%s\n", g_menu.swap_oc ? "on" : "off");
+    fprintf(out, "screen_filter=%s\nfxaa=%s\n", g_menu.post.scaling == PF_NEAREST ? "nearest" : g_menu.post.scaling == PF_SHARP_BILINEAR ? "sharp" : "bilinear",
+            g_menu.post.fxaa ? "on" : "off");
+    fprintf(out, "scale=%d\n", g_menu.iscale);
+    fprintf(out, "fog=%s\naniso=%d\ndraw_distance=%s\n", g_menu.fog ? "on" : "off", g_menu.aniso, g_menu.draw_dist == 2 ? "max" : g_menu.draw_dist ? "far" : "normal");
+    fprintf(out, "mipmaps=%s\ncustom_textures=%s\n", g_menu.mipmaps ? "on" : "off", g_menu.custom_tex ? "on" : "off");
+    fclose(out);
+    remove(BASE "/psp2i.ini");
+    if (rename(BASE "/psp2i.ini.new", BASE "/psp2i.ini") != 0) fprintf(stderr, "menu: cannot replace psp2i.ini\n");
+}
+
+static void menu_apply(int fx) {
+    if (!fx) return;
+    int save = 0;
+    if (fx & MFX_FPS_CHANGED) { framerate_set(g_menu.fps); save = 1; }
+    if (fx & MFX_SHOW_FPS) { g_fps_on = g_menu.show_fps; save = 1; }
+    if (fx & MFX_RS_SPEED) { camera_set_speed(menu_rs_speed(&g_menu)); save = 1; }
+    if (fx & MFX_RS_ON) save = 1;
+    if (fx & MFX_AUDIO) { audio_apply(); save = 1; }
+    if (fx & MFX_SWAP_OC) { g_swap_oc = g_menu.swap_oc; save = 1; }
+    if (fx & MFX_POSTFX) { post_apply(); save = 1; }
+    if (fx & MFX_ISCALE) save = 1;
+    if (fx & MFX_MIPMAPS) { g_mipmaps = g_menu.mipmaps; gl_ge_set_mipmaps(g_mipmaps); fprintf(stderr, "menu: mipmaps %s\n", g_mipmaps ? "on" : "off"); save = 1; }
+    if (fx & MFX_CUSTOM_TEX) {
+        g_custom_tex = g_menu.custom_tex;
+        gl_ge_set_custom_textures(g_custom_tex, BASE "/textures");
+        fprintf(stderr, "menu: custom textures %s\n", g_custom_tex ? "on" : "off");
+        save = 1;
+    }
+    if (fx & MFX_FOG) { g_fog = g_menu.fog; gl_ge_set_fog(g_fog); fprintf(stderr, "menu: fog %s\n", g_fog ? "on" : "off"); save = 1; }
+    if (fx & MFX_ANISO) { g_aniso = g_menu.aniso; gl_ge_set_aniso(menu_aniso_level(&g_menu));
+                          fprintf(stderr, "menu: anisotropic filtering %dx\n", menu_aniso_level(&g_menu)); save = 1; }
+    if (fx & MFX_DRAW_DIST) { g_draw_dist = g_menu.draw_dist; save = 1; }
+    if (fx & MFX_TESTS) framerate_set_tests(g_menu.test_ticks, g_menu.test_logic);   /* for this session only */
+    if (fx & MFX_FPS_CHANGED) fprintf(stderr, "menu: frame rate %d\n", g_menu.fps);
+    if (save) write_ini();
+    if (fx & ~(MFX_OPENED | MFX_CLOSED)) {
+        /* For a few seconds after a change the log is flushed every vblank: under
+         * kaiHEN a crash leaves no report, so this is how one after a setting shows. */
+        g_log_flush_until = g_vblanks + 600;
+        fflush(stderr);
+    }
+}
+
+/* ---- hang reports ------------------------------------------------------------- */
+
+/* A small thread that only sleeps and watches the vblank count; it reads no
+ * files (the kaiHEN lesson). When vblanks stop for 3 s -- the game stuck in a
+ * loop, or the renderer in a GPU wait, so input and + - no longer work -- it
+ * writes logs/hang.log once: where the host and the renderer were, the PSP
+ * thread, and the last 64 firmware calls. Re-armed when vblanks resume. */
+static volatile uint64_t g_vb_tick;
+static volatile int g_wd_stop;
+static Thread g_wd;
+static int g_wd_up;
+
+static void hang_report(uint64_t vb, int secs) {
+    FILE *f = fopen(BASE "/logs/hang.log", "a");
+    if (!f) return;
+    char when[32];
+    now_text(when, sizeof when);
+    fprintf(f, "%s build %d: no vblank for %d s after vblank %llu\n", when, PSP2I_SWITCH_BUILD, secs, (unsigned long long)vb);
+    fprintf(f, "  host: %s\n  renderer: %s\n  PSP thread: %s\n", (const char *)g_host_stage, (const char *)gl_ge_stage,
+            psp_thread_current_name());
+    fprintf(f, "  last firmware calls (newest first; ra = the game's return address):\n");
+    const uint32_t n = psp_hle_trail_n;
+    for (uint32_t i = 0; i < PSP_HLE_TRAIL && i < n; i++) {
+        const volatile psp_hle_crumb *c = &psp_hle_trail[(n - 1 - i) % PSP_HLE_TRAIL];
+        if (c->name) fprintf(f, "    %-40s ra 0x%08X\n", c->name, c->ra);
+        else         fprintf(f, "    NID 0x%08X%-29s ra 0x%08X\n", c->nid, "", c->ra);
+    }
+    fprintf(f, "  firmware calls so far: %u\n\n", n);
+    fclose(f);
+    fprintf(stderr, "hang: no vblank for %d s after vblank %llu (see hang.log)\n", secs, (unsigned long long)vb);
+    fflush(stderr);                     /* the log is buffered; a hang that never ends would lose it */
+}
+
+static void wd_main(void *arg) {
+    (void)arg;
+    uint64_t last = g_vb_tick;
+    int still = 0, reported = 0;
+    while (!g_wd_stop) {
+        svcSleepThread(500000000ull);
+        const uint64_t now = g_vb_tick;
+        if (now != last || now == 0) { last = now; still = 0; reported = 0; continue; }
+        if (++still >= 6 && !reported) { hang_report(now, still / 2); reported = 1; }
+    }
+}
+
+static void watchdog_start(void) {
+    if (R_FAILED(threadCreate(&g_wd, wd_main, NULL, NULL, 0x10000, 0x20, -2))) { fprintf(stderr, "watchdog: not started\n"); return; }
+    if (R_FAILED(threadStart(&g_wd))) { threadClose(&g_wd); fprintf(stderr, "watchdog: not started\n"); return; }
+    g_wd_up = 1;
+}
+
+static void watchdog_stop(void) {
+    if (!g_wd_up) return;
+    g_wd_stop = 1;
+    threadWaitForExit(&g_wd);
+    threadClose(&g_wd);
+    g_wd_up = 0;
+}
+
+/* ---- sampling profiler (PSP2I_PROFILE builds) ----------------------------------- */
+
+#ifdef PSP2I_PROFILE
+/* A thread on a spare core reads psp_prof_cur -- the guest block the game
+ * thread last entered (or 1 idle, 2 firmware, 3 GE wait) -- every 100 us into
+ * a histogram; no file I/O on it. L3 clears the histogram; quitting writes
+ * logs/profile.txt (main thread). */
+#define PROF_SLOTS (1u << 17)
+static struct { uint32_t addr, n; } g_prof[PROF_SLOTS];
+static volatile uint64_t g_prof_total;
+static volatile int g_prof_stop;
+static Thread g_prof_thread;
+static int g_prof_up;
+
+/* The last samples in order, so a long frame can be attributed to the code
+ * that ran during it (prof_note_spike, main thread, at the frame's end). */
+#define PROF_RING (1u << 15)
+static uint32_t g_sring[PROF_RING];
+static volatile uint32_t g_sring_n;
+static struct { uint32_t addr, n; } g_sprof[PROF_SLOTS];
+static uint64_t g_sprof_total;
+static uint32_t g_sprof_frames;
+
+static void prof_add(void *tab, uint32_t a) {
+    struct { uint32_t addr, n; } *t = tab;
+    uint32_t h = (a * 2654435761u) >> 15;
+    for (uint32_t k = 0; k < PROF_SLOTS; k++, h++) {
+        const uint32_t j = h & (PROF_SLOTS - 1);
+        if (t[j].addr == a || t[j].n == 0) { t[j].addr = a; t[j].n++; break; }
+    }
+}
+
+/* Frames a little over budget (12..25 ms busy: the dodge-roll kind, not loads).
+ * All samples from the frame's start to its end go to g_rprof. */
+static struct { uint32_t addr, n; } g_rprof[PROF_SLOTS];
+static uint64_t g_rprof_total;
+static uint32_t g_rprof_frames, g_frame_ring0;
+static void prof_note_spike(uint64_t busy_ns) {
+    const uint32_t end = g_sring_n;
+    uint32_t want = end - g_frame_ring0;                /* the whole frame, idle included */
+    if (want > PROF_RING - 1) want = PROF_RING - 1;
+    const int roll = busy_ns >= 12000000u && busy_ns < 25000000u;
+    for (uint32_t i = 0; i < want; i++) prof_add(roll ? (void *)g_rprof : (void *)g_sprof, g_sring[(end - 1 - i) & (PROF_RING - 1)]);
+    if (roll) { g_rprof_total += want; g_rprof_frames++; }
+    else { g_sprof_total += want; g_sprof_frames++; }
+}
+
+static void prof_main(void *arg) {
+    (void)arg;
+    while (!g_prof_stop) {
+        svcSleepThread(100000);
+        if (g_prof_reset) { memset(g_prof, 0, sizeof g_prof); g_prof_total = 0; g_prof_reset = 0; }
+        const uint32_t a = psp_prof_cur;
+        g_sring[g_sring_n & (PROF_RING - 1)] = a;
+        g_sring_n = g_sring_n + 1;
+        uint32_t h = (a * 2654435761u) >> 15;
+        for (uint32_t k = 0; k < PROF_SLOTS; k++, h++) {
+            const uint32_t j = h & (PROF_SLOTS - 1);
+            if (g_prof[j].addr == a || g_prof[j].n == 0) { g_prof[j].addr = a; g_prof[j].n++; break; }
+        }
+        g_prof_total++;
+    }
+}
+
+static void prof_start(void) {
+    u64 mask = 0;
+    svcGetInfo(&mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+    const int core = (mask >> 4) & 1 ? 4 : -2;
+    if (R_SUCCEEDED(threadCreate(&g_prof_thread, prof_main, NULL, NULL, 0x10000, 0x2B, core)) && R_SUCCEEDED(threadStart(&g_prof_thread))) {
+        g_prof_up = 1;
+        fprintf(stderr, "profile: sampling the game thread every 100 us on core %d (L3 clears)\n", core);
+    }
+}
+
+static int prof_cmp(const void *a, const void *b) {
+    const uint32_t x = ((const uint32_t *)a)[1], y = ((const uint32_t *)b)[1];
+    return x < y ? 1 : x > y ? -1 : 0;
+}
+
+static void prof_stop(void) {
+    if (!g_prof_up) return;
+    g_prof_stop = 1;
+    threadWaitForExit(&g_prof_thread);
+    threadClose(&g_prof_thread);
+    static uint32_t rows[PROF_SLOTS][2];
+    uint32_t n = 0;
+    for (uint32_t j = 0; j < PROF_SLOTS; j++) if (g_prof[j].n) { rows[n][0] = g_prof[j].addr; rows[n][1] = g_prof[j].n; n++; }
+    qsort(rows, n, sizeof rows[0], prof_cmp);
+    FILE *f = fopen(BASE "/logs/profile.txt", "w");
+    if (!f) return;
+    fprintf(f, "# build %d: %llu samples (100 us each); 1 = idle, 2 = firmware call, 3 = waiting for the GE thread\n",
+            PSP2I_SWITCH_BUILD, (unsigned long long)g_prof_total);
+    for (uint32_t i = 0; i < n; i++) fprintf(f, "%08X %u\n", rows[i][0], rows[i][1]);
+    n = 0;
+    for (uint32_t j = 0; j < PROF_SLOTS; j++) if (g_sprof[j].n) { rows[n][0] = g_sprof[j].addr; rows[n][1] = g_sprof[j].n; n++; }
+    qsort(rows, n, sizeof rows[0], prof_cmp);
+    fprintf(f, "# spikes: %u frames over 25 ms busy, %llu samples from them\n", g_sprof_frames, (unsigned long long)g_sprof_total);
+    for (uint32_t i = 0; i < n; i++) fprintf(f, "S %08X %u\n", rows[i][0], rows[i][1]);
+    n = 0;
+    for (uint32_t j = 0; j < PROF_SLOTS; j++) if (g_rprof[j].n) { rows[n][0] = g_rprof[j].addr; rows[n][1] = g_rprof[j].n; n++; }
+    qsort(rows, n, sizeof rows[0], prof_cmp);
+    fprintf(f, "# near misses: %u frames of 12-25 ms busy, %llu samples from them\n", g_rprof_frames, (unsigned long long)g_rprof_total);
+    for (uint32_t i = 0; i < n; i++) fprintf(f, "R %08X %u\n", rows[i][0], rows[i][1]);
+    fclose(f);
+    fprintf(stderr, "profile: %u addresses written to logs/profile.txt\n", n);
+}
+#endif
+
+/* ---- once per vblank, on the scheduler's clock --------------------------------- */
+
+/* g_vblanks: declared above menu_apply */
+
+static uint64_t g_vbhook_max;     /* longest vblank hook (host work at a vblank), ns */
+static void on_vblank_body(void);
+static void on_vblank(void) {
+    const uint64_t a = now_ns();
+    on_vblank_body();
+    const uint64_t d = now_ns() - a;
+    if (d > g_vbhook_max) g_vbhook_max = d;
+}
+static void on_vblank_body(void) {
+    g_vb_tick++;
+    draw_dist_apply();
+    if (g_custom_tex) texpack_pump(3.0);      /* custom-texture PNGs: on this thread (see texpack.c) */
+    if (g_vblanks < g_log_flush_until) fflush(stderr);
+    {
+        size_t len = 0;
+        char *d = psp_gpu_dump_take(&len);
+        if (d) {
+            static int n;
+            char path[160];
+            snprintf(path, sizeof path, BASE "/logs/ge_frame_%d.txt", ++n);
+            FILE *f = fopen(path, "w");
+            if (f) { fprintf(f, "# build %d, internal %dx\n", PSP2I_SWITCH_BUILD, g_scale); fwrite(d, 1, len, f); fclose(f); }
+            fprintf(stderr, "ge-dump: %zu KB -> %s\n", len >> 10, path);
+            free(d);
+            /* and the last ~6 s of character positions (a roll's camera snap, ...) */
+            snprintf(path, sizeof path, BASE "/logs/track_%d.txt", n);
+            if ((f = fopen(path, "w"))) {
+                fprintf(f, "# build %d, %d fps target: per frame (from a clear), the flip, then each skinned draw's first-bone translation (camera space)\n",
+                        PSP2I_SWITCH_BUILD, framerate_target());
+                psp_gpu_track_dump(f);
+                fclose(f);
+            }
+        }
+    }
+    g_host_stage = "vblank: applet/input";
+    if (!appletMainLoop()) psp_request_exit();
+    audio_pump();
+    uint8_t ax = 128, ay = 128, rx = 128, ry = 128;
+    const uint32_t pad = pad_state(&ax, &ay, &rx, &ry);
+    const uint32_t held = menu_inputs_from_psp(pad, ax, ay) | (g_menu_toggle ? MI_TOGGLE : 0);
+    menu_apply(menu_update(&g_menu, held, 0));
+    const uint32_t game = menu_filter_game(&g_menu, pad);
+    if (g_menu.open) { ax = ay = rx = ry = 128; }
+    if (!g_menu.rs_on) rx = ry = 128;
+    psp_ctrl_set(game, ax, ay);
+    camera_set_stick(rx, ry);
+    g_host_stage = "vblank: present";
+    const uint64_t t0 = now_ns();
+    present();
+    g_host_stage = "game (PSP code)";
+    if (!g_t_last) g_t_last = t0;
+    /* Spikes: what each frame cost and why vblanks went without a new frame. */
+    static uint64_t sp_t, sp_idle, sp_flips, sp_gl, sp_acc, sp_hist[6], sp_late, sp_repeat, sp_max_vb, sp_max_frame, sp_max_gl;
+    {
+        const uint64_t idle = psp_sched_idle_us() * 1000u, fl = psp_display_flips();
+#ifndef PSP2I_SOFTWARE_VIDEO
+        const uint64_t gl = gl_ge_busy_ns();
+#else
+        const uint64_t gl = 0;
+#endif
+        if (sp_t) {
+            const uint64_t dt = t0 - sp_t, di = idle - sp_idle;
+            if (dt > sp_max_vb) sp_max_vb = dt;
+            if (dt > 18500000u) sp_late++;
+            if (gl - sp_gl > sp_max_gl) sp_max_gl = gl - sp_gl;
+            sp_acc += dt > di ? dt - di : 0;
+            if (fl != sp_flips) {
+                /* A long frame: what the firmware was asked for during it (spike log, a few per 30 s). */
+                static uint32_t sp_trail_last, sp_logged;
+                const uint32_t tn = psp_hle_trail_n;
+                if (g_vblanks % 1800 == 0) sp_logged = 0;
+#ifdef PSP2I_PROFILE
+                {
+                    uint32_t fvs, fvr, fprs, fprsb;
+                    fastpaths_frame_counts(&fvs, &fvr, &fprs, &fprsb);
+                    if (sp_acc > 12000000u && g_prof_up) {
+                        prof_note_spike(sp_acc);
+                        static uint32_t nm_logged;
+                        if (sp_acc < 25000000u && nm_logged++ < 300) {
+                            /* the frame's three hottest code blocks */
+                            uint32_t top[3] = {0}, cnt[3] = {0}, want = g_sring_n - g_frame_ring0;
+                            if (want > 4096) want = 4096;
+                            static uint32_t seen_a[4096], seen_n[4096];
+                            uint32_t ns = 0;
+                            for (uint32_t i = 0; i < want; i++) {
+                                const uint32_t a = g_sring[(g_sring_n - 1 - i) & (PROF_RING - 1)];
+                                if (a < 16) continue;
+                                uint32_t k = 0;
+                                while (k < ns && seen_a[k] != a) k++;
+                                if (k == ns) { seen_a[ns] = a; seen_n[ns] = 0; ns++; }
+                                seen_n[k]++;
+                            }
+                            for (uint32_t k = 0; k < ns; k++)
+                                for (int t = 0; t < 3; t++) if (seen_n[k] > cnt[t]) {
+                                    for (int u = 2; u > t; u--) { cnt[u] = cnt[u - 1]; top[u] = top[u - 1]; }
+                                    cnt[t] = seen_n[k]; top[t] = seen_a[k]; break;
+                                }
+                            fprintf(stderr, "near miss: vblank %llu, %.1f ms busy; native: %u VRAM saves, %u restores, %u PRS (%u KB); hottest %08X:%.1f %08X:%.1f %08X:%.1f ms\n",
+                                    (unsigned long long)g_vblanks, sp_acc / 1e6, fvs, fvr, fprs, fprsb >> 10,
+                                    top[0], cnt[0] / 10.0, top[1], cnt[1] / 10.0, top[2], cnt[2] / 10.0);
+                        }
+                    }
+                }
+                g_frame_ring0 = g_sring_n;
+#endif
+                if (sp_acc > 17500000u && sp_logged < 6) {
+                    sp_logged++;
+                    char names[360]; size_t len = 0; names[0] = 0;
+                    const char *seen[12]; int ns = 0;
+                    const uint32_t calls = tn - sp_trail_last;
+                    for (uint32_t i = 0; i < PSP_HLE_TRAIL && i < calls && i < tn; i++) {
+                        const volatile psp_hle_crumb *c = &psp_hle_trail[(tn - 1 - i) % PSP_HLE_TRAIL];
+                        const char *nm = c->name ? c->name : "?";
+                        int dup = 0;
+                        for (int j = 0; j < ns; j++) if (seen[j] == nm) dup = 1;
+                        if (dup || ns == 12) continue;
+                        seen[ns++] = nm;
+                        len += (size_t)snprintf(names + len, len < sizeof names ? sizeof names - len : 0, "%s%s@%08X", ns > 1 ? " " : "", nm, c->ra);
+                        if (len >= sizeof names) break;
+                    }
+                    uint64_t gap = 0, rd = 0; uint32_t rdb = 0; const char *gth = "", *gcall = "";
+                    psp_sched_gap_stats(&gap, &gth, &gcall);
+                    psp_io_read_stats(&rd, &rdb);
+                    char thr[200], hl[260];
+                    psp_sched_thread_top(thr, sizeof thr, 4);
+                    psp_hle_time_top_nonblocking(hl, sizeof hl, 4);
+                    fprintf(stderr, "  spike detail: threads (ms) %s; firmware work (ms) %s\n", thr, hl);
+                    fprintf(stderr, "  spike: vblank %llu, a frame of %.1f ms busy; longest run without a scheduling point %.1f ms (thread '%s', after %s); "
+                                    "longest file read %.1f ms (%u bytes); longest vblank host work %.1f ms; %u firmware calls during it (newest first): %s\n",
+                            (unsigned long long)g_vblanks, sp_acc / 1e6, gap / 1e3, gth, gcall, rd / 1e3, rdb, g_vbhook_max / 1e6, calls, names);
+                }
+                sp_trail_last = tn;
+                { uint64_t g_; const char *a_, *b_; psp_sched_gap_stats(&g_, &a_, &b_); uint64_t r_; uint32_t rb_; psp_io_read_stats(&r_, &rb_);
+                  char t_[8], h_[8]; psp_sched_thread_top(t_, 0, 0); psp_hle_time_top_nonblocking(h_, 0, 0); (void)t_; (void)h_; }
+                g_vbhook_max = 0;
+                const uint64_t ms10 = sp_acc / 100000u;     /* 0.1 ms */
+                sp_hist[ms10 < 80 ? 0 : ms10 < 120 ? 1 : ms10 < 140 ? 2 : ms10 < 167 ? 3 : ms10 < 200 ? 4 : 5]++;
+                if (sp_acc > sp_max_frame) sp_max_frame = sp_acc;
+                sp_acc = 0;
+            } else sp_repeat++;
+        }
+        sp_t = t0; sp_idle = idle; sp_flips = fl; sp_gl = gl;
+    }
+    if (++g_vblanks % (60 * 30) == 0) {
+        {
+            uint64_t rn = 0, rns = 0, rmax = 0;
+#ifndef PSP2I_SOFTWARE_VIDEO
+            gl_ge_readback_stats(&rn, &rns, &rmax);
+            uint64_t vn = 0, vus = 0; char vtop[96];
+            gl_ge_vram_waits(&vn, &vus, vtop, sizeof vtop);
+            { static uint64_t lvn, lvus; const uint64_t a = vn, b = vus; vn -= lvn; vus -= lvus; lvn = a; lvus = b; }
+#else
+            uint64_t vn = 0, vus = 0; char vtop[4] = "";
+#endif
+            fprintf(stderr, "  frames by game-thread busy ms: <8 %llu, 8-12 %llu, 12-14 %llu, 14-16.7 %llu, 16.7-20 %llu, >20 %llu; worst %.1f ms\n"
+                            "  vblanks: %llu without a new frame, %llu late (>18.5 ms), longest gap %.1f ms; GE work in one vblank up to %.1f ms, present up to %.1f ms\n"
+                            "  readbacks %llu (%.1f ms, longest %.2f ms); game VRAM accesses that waited %llu, %.1f ms, top sites (all run, ra:ms) %s\n",
+                    (unsigned long long)sp_hist[0], (unsigned long long)sp_hist[1], (unsigned long long)sp_hist[2], (unsigned long long)sp_hist[3],
+                    (unsigned long long)sp_hist[4], (unsigned long long)sp_hist[5], sp_max_frame / 1e6,
+                    (unsigned long long)sp_repeat, (unsigned long long)sp_late, sp_max_vb / 1e6, sp_max_gl / 1e6, g_present_max / 1e6,
+                    (unsigned long long)rn, rns / 1e6, rmax / 1e6, (unsigned long long)vn, vus / 1e3, vtop);
+#ifndef PSP2I_SOFTWARE_VIDEO
+            {
+                char rbc[480]; uint64_t dmax = 0, dslow = 0;
+                gl_ge_readback_census(rbc, sizeof rbc);
+                gl_ge_draw_spikes(&dmax, &dslow);
+                struct ouncevk_profile op;
+                if (ouncevk_profile_read(&op, true)) {
+                    const struct ouncevk_profile_timer_stats *j = &op.timers[OUNCEVK_PROFILE_JOIN], *f = &op.timers[OUNCEVK_PROFILE_FLUSH],
+                                                             *pr = &op.timers[OUNCEVK_PROFILE_PRESENT], *aq = &op.timers[OUNCEVK_PROFILE_ACQUIRE];
+                    fprintf(stderr, "  gpu: waits for the GPU %llu (%.1f ms, longest %.1f ms); submits %llu (longest %.1f ms); acquire longest %.1f ms, present longest %.1f ms\n",
+                            (unsigned long long)j->count, j->total_us / 1e3, j->max_us / 1e3, (unsigned long long)f->count, f->max_us / 1e3,
+                            aq->max_us / 1e3, pr->max_us / 1e3);
+                }
+                fprintf(stderr, "  draws: longest %.2f ms, %llu over 2 ms; readbacks by source: %s\n", dmax / 1e6, (unsigned long long)dslow, rbc[0] ? rbc : "none");
+                { char tm[900]; gl_ge_tex_miss_census(tm, sizeof tm); fprintf(stderr, "  textures over drawn targets, decoded from VRAM: %s\n", tm[0] ? tm : "none"); }
+            }
+#endif
+            memset(sp_hist, 0, sizeof sp_hist);
+            sp_late = sp_repeat = sp_max_vb = sp_max_frame = sp_max_gl = 0; g_present_max = 0;
+        }
+        static uint64_t last_flips, last_idle, last_gl;
+        const uint64_t flips = psp_display_flips(), wall = t0 - g_t_last;
+        const uint64_t idle_ns = (psp_sched_idle_us() - last_idle) * 1000u;
+#ifndef PSP2I_SOFTWARE_VIDEO
+        const uint64_t gl_ns = gl_ge_busy_ns() - last_gl;
+        last_gl = gl_ge_busy_ns();
+#else
+        const uint64_t gl_ns = 0;
+#endif
+        last_idle = psp_sched_idle_us();
+        const uint64_t frames = flips - last_flips;
+        static uint64_t last_wait_us, last_vram_us, last_skipped;
+        uint64_t ge_waits = 0, ge_wait_us = 0, ge_job_us = 0, vram_n = 0, vram_us = 0;
+#ifndef PSP2I_SOFTWARE_VIDEO
+        psp_ge_thread_stats(&ge_waits, &ge_wait_us, &ge_job_us);
+        { char top[96]; gl_ge_vram_waits(&vram_n, &vram_us, top, sizeof top); }
+#endif
+        const uint64_t wait_ns = (ge_wait_us - last_wait_us + vram_us - last_vram_us) * 1000u;
+        last_wait_us = ge_wait_us; last_vram_us = vram_us;
+        if (frames) {
+            const double per = 1e6 * (double)frames;
+            if (psp_ge_threaded()) {
+                const double game = (double)wall - (double)idle_ns - (double)wait_ns;
+                fprintf(stderr, "  per game frame: game thread: code %.2f ms, waiting for the GE thread %.2f ms, idle %.2f ms; "
+                                "GE thread: draws %.2f ms, present %.2f ms; %llu frames not shown (GE thread behind)\n",
+                        game > 0 ? game / per : 0.0, (double)wait_ns / per, (double)idle_ns / per, (double)gl_ns / per,
+                        (double)g_t_present / per, (unsigned long long)(g_present_skipped - last_skipped));
+            } else {
+                const double game = (double)wall - (double)idle_ns - (double)gl_ns - (double)g_t_present;
+                fprintf(stderr, "  per game frame: game code %.2f ms, renderer draws %.2f ms, present %.2f ms, idle %.2f ms\n",
+                        game > 0 ? game / per : 0.0, (double)gl_ns / per, (double)g_t_present / per, (double)idle_ns / per);
+            }
+        }
+        last_skipped = g_present_skipped;
+        {
+            char top[400];
+            psp_hle_time_top(top, sizeof top, 6);
+            fprintf(stderr, "  firmware calls by time over 30 s (ms; waits include other threads): %s\n", top);
+        }
+        fprintf(stderr, "alive: %llu vblanks, %llu flips (%.1f game fps over 30 s), audio underruns %llu, overflows %llu, "
+                        "queue %.0f ms, rate %+.2f%%; per vblank: present %.2f ms (swap %.2f ms), everything else %.2f ms\n",
+                (unsigned long long)g_vblanks, (unsigned long long)flips,
+                wall ? (double)(flips - last_flips) * 1e9 / (double)wall : 0.0, (unsigned long long)g_underruns,
+                (unsigned long long)g_overflows, g_queue_avg * 1000.0 / IN_RATE, (g_rate_adj - 1.0) * 100.0,
+                (double)g_t_present / 1800 / 1e6, (double)g_t_swap / 1800 / 1e6,
+                wall > g_t_present ? (double)(wall - g_t_present) / 1800 / 1e6 : 0.0);
+        last_flips = flips;
+        g_t_present = g_t_swap = 0;
+        g_t_last = t0;
+    }
+}
+
+/* ---- the game files --------------------------------------------------------------- */
+
+static int path_exists(const char *p) { struct stat st; return stat(p, &st) == 0; }
+
+/* The first .iso in sdmc:/switch/psp2i/ when psp2i.ini names none. */
+static int find_iso(char *out, size_t cap) {
+    DIR *d = opendir(BASE);
+    if (!d) return 0;
+    struct dirent *e;
+    int found = 0;
+    while (!found && (e = readdir(d))) {
+        const size_t n = strlen(e->d_name);
+        if (n > 4 && !strcasecmp(e->d_name + n - 4, ".iso")) { snprintf(out, cap, BASE "/%s", e->d_name); found = 1; }
+    }
+    closedir(d);
+    return found;
+}
+
+/* The disc image into memory, with a progress bar. A read from the SD card
+ * now and then takes 40 ms -- even 16 KB -- and the game reads while it
+ * plays (a loader thread streaming data), so each such read was a dropped
+ * frame. From memory nothing waits. Done on the main thread, before the
+ * game starts: threads the port makes that read files are not safe under
+ * kaiHEN. */
+static void preload_bar(double frac) {
+#ifndef PSP2I_SOFTWARE_VIDEO
+    int cw, ch;
+    surface_size(&cw, &ch);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(0, 0, cw, ch);
+    glDisable(GL_SCISSOR_TEST);
+    glClearColor(0.05f, 0.05f, 0.08f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    const int bw = cw * 2 / 3, bh = ch / 40, bx = (cw - bw) / 2, by = ch / 2 - bh / 2;
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(bx - 2, by - 2, bw + 4, bh + 4); glClearColor(0.35f, 0.35f, 0.4f, 1.0f); glClear(GL_COLOR_BUFFER_BIT);
+    glScissor(bx, by, bw, bh);                 glClearColor(0.08f, 0.08f, 0.1f, 1.0f); glClear(GL_COLOR_BUFFER_BIT);
+    glScissor(bx, by, (int)(bw * frac), bh);   glClearColor(0.25f, 0.6f, 0.95f, 1.0f); glClear(GL_COLOR_BUFFER_BIT);
+    glDisable(GL_SCISSOR_TEST);
+    eglSwapBuffers(g_dpy, g_surf);
+#else
+    (void)frac;
+#endif
+}
+
+static void preload_iso(void) {
+    if (!g_preload || !g_iso_path[0] || !psp_io_has_disc_image()) return;
+    struct stat stt;
+    if (stat(g_iso_path, &stt) != 0 || stt.st_size <= 0) return;
+    const size_t size = (size_t)stt.st_size;
+    uint8_t *buf = (uint8_t *)malloc(size);
+    if (!buf) { fprintf(stderr, "preload: no memory for %zu MB; reading from the SD card\n", size >> 20); return; }
+    FILE *f = fopen(g_iso_path, "rb");
+    if (!f) { free(buf); return; }
+    const uint64_t t0 = now_ns();
+    size_t got = 0, chunk = 8u << 20;
+    uint64_t last_draw = 0;
+    while (got < size) {
+        const size_t want = size - got < chunk ? size - got : chunk;
+        const size_t n = fread(buf + got, 1, want, f);
+        got += n;
+        if (n < want) break;
+        const uint64_t t = now_ns();
+        if (t - last_draw > 33000000u) { preload_bar((double)got / (double)size); last_draw = t; }
+        if (!appletMainLoop()) break;
+    }
+    fclose(f);
+    const double secs = (now_ns() - t0) / 1e9;
+    if (got != size) { fprintf(stderr, "preload: stopped at %zu of %zu MB; reading from the SD card\n", got >> 20, size >> 20); free(buf); return; }
+    FILE *m = fmemopen(buf, size, "rb");
+    if (!m || psp_io_set_disc_image(m) != 0) {
+        fprintf(stderr, "preload: the in-memory image did not open; reading from the SD card\n");
+        if (m) fclose(m);
+        free(buf);
+        psp_io_open_disc_image(g_iso_path);
+        return;
+    }
+    fprintf(stderr, "preload: disc image in memory, %zu MB in %.1f s (%.0f MB/s)\n", size >> 20, secs, secs > 0 ? (size >> 20) / secs : 0.0);
+    preload_bar(1.0);
+}
+
+static uint8_t *find_game(const char *root, size_t *len) {
+    char p[700], msg[900];
+    snprintf(p, sizeof p, "%s/disc/PSP_GAME", root);
+    const int extracted = path_exists(p);
+    if (!extracted) {
+        if (g_iso_path[0] && !path_exists(g_iso_path)) {   /* psp2i.ini's iso= gone (moved from the old sdmc:/psp2i/): look again */
+            fprintf(stderr, "iso: %s not found; looking in " BASE "\n", g_iso_path);
+            g_iso_path[0] = '\0';
+        }
+        if (!g_iso_path[0]) find_iso(g_iso_path, sizeof g_iso_path);
+        if (!g_iso_path[0] && path_exists("sdmc:/psp2i")) {
+            fail("The port's folder has moved: move the contents of sdmc:/psp2i/ (the ISO, GameData, textures, psp2i.ini) into sdmc:/switch/psp2i/, beside psp2i.nro");
+            return NULL;
+        }
+        if (!g_iso_path[0]) { fail("No game found. Put your English-patched Phantasy Star Portable 2 Infinity .iso in sdmc:/switch/psp2i/ (see psp2i.wiki/w/Installation#English_patch)"); return NULL; }
+        fprintf(stderr, "iso: %s\n", g_iso_path);
+        if (psp_io_open_disc_image(g_iso_path) != 0) {
+            snprintf(msg, sizeof msg, "%s is not a PSP disc image the port can read.", g_iso_path);
+            fail(msg);
+            return NULL;
+        }
+    }
+    size_t n = 0;
+    uint8_t *b = read_file(BASE "/EBOOT.BIN", &n);
+    if (b) fprintf(stderr, "eboot: " BASE "/EBOOT.BIN\n");
+    if (!b && extracted) {
+        snprintf(p, sizeof p, "%s/disc/PSP_GAME/SYSDIR/EBOOT.BIN", root);
+        b = read_file(p, &n);
+    }
+    if (!b && !extracted) {
+        uint32_t l = 0;
+        b = psp_io_disc_file("PSP_GAME/SYSDIR/EBOOT.BIN", &l);
+        n = l;
+    }
+    if (!b) { fail("The disc has no PSP_GAME/SYSDIR/EBOOT.BIN."); return NULL; }
+    if (n < 4 || memcmp(b, "\x7F" "ELF", 4) != 0) {
+        fail("This ISO is not the English-patched version (its EBOOT.BIN is encrypted). Only the English patch is supported: see psp2i.wiki/w/Installation#English_patch");
+        free(b);
+        return NULL;
+    }
+    snprintf(p, sizeof p, "%s/flash/font", root);
+    if (!path_exists(p)) fprintf(stderr, "psp2i: no fonts in %s; the game's text may not show\n", p);
+    *len = n;
+    return b;
+}
+
+static void net_line(const char *line) { fprintf(stderr, "net: %s\n", line); }
+
+/* ---- start-up ------------------------------------------------------------------ */
+
+/* A crash (data abort and the like) writes logs/crash.log: the faulting
+ * address, the registers and the frame-pointer chain, as offsets into the NRO
+ * so they map onto psp2i.elf (aarch64-none-elf-addr2line -e psp2i.elf). */
+u8 __nx_exception_stack[0x8000] __attribute__((aligned(16)));
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+u32 __nx_exception_ignoredebug = 1;
+extern char _start[];
+void __libnx_exception_handler(ThreadExceptionDump *ctx) {
+    fflush(stderr);
+    FILE *f = fopen(BASE "/logs/crash.log", "w");
+    if (f) {
+        const u64 base = (u64)_start;
+        fprintf(f, "crash: error_desc 0x%X, build %d\n", ctx->error_desc, PSP2I_SWITCH_BUILD);
+        fprintf(f, "pc  0x%016llX (nro+0x%llX)\n", (unsigned long long)ctx->pc.x, (unsigned long long)(ctx->pc.x - base));
+        fprintf(f, "lr  0x%016llX (nro+0x%llX)\n", (unsigned long long)ctx->lr.x, (unsigned long long)(ctx->lr.x - base));
+        fprintf(f, "sp  0x%016llX  far 0x%016llX  esr 0x%X\n", (unsigned long long)ctx->sp.x, (unsigned long long)ctx->far.x, ctx->esr);
+        for (int i = 0; i < 29; i++) fprintf(f, "x%-2d 0x%016llX%s", i, (unsigned long long)ctx->cpu_gprs[i].x, i % 3 == 2 ? "\n" : "  ");
+        fprintf(f, "\nfp chain:");
+        u64 fp = ctx->fp.x;
+        for (int i = 0; i < 24 && fp && !(fp & 7); i++) {
+            const u64 *fr = (const u64 *)fp;
+            const u64 ret = fr[1];
+            if (!ret) break;
+            fprintf(f, " nro+0x%llX", (unsigned long long)(ret - base));
+            if (fr[0] <= fp) break;
+            fp = fr[0];
+        }
+        fprintf(f, "\n");
+        fclose(f);
+    }
+    svcExitProcess();
+}
+
+/* abort(), a failed assert() and libnx's own aborts don't fault, so the
+ * handler above never sees them: these write logs/crash.log too. */
+static void abort_report(const char *what) {
+    fflush(stderr);
+    FILE *f = fopen(BASE "/logs/crash.log", "w");
+    if (!f) return;
+    const u64 base = (u64)_start;
+    fprintf(f, "abort: %s, build %d\n", what, PSP2I_SWITCH_BUILD);
+    fprintf(f, "caller nro+0x%llX\nfp chain:", (unsigned long long)((u64)__builtin_return_address(0) - base));
+    u64 fp = (u64)__builtin_frame_address(0);
+    for (int i = 0; i < 32 && fp && !(fp & 7); i++) {
+        const u64 *fr = (const u64 *)fp;
+        if (!fr[1]) break;
+        fprintf(f, " nro+0x%llX", (unsigned long long)(fr[1] - base));
+        if (fr[0] <= fp) break;
+        fp = fr[0];
+    }
+    fprintf(f, "\n");
+    fclose(f);
+}
+void __real_abort(void);
+void __wrap_abort(void) { abort_report("abort()"); __real_abort(); }
+void __real___assert_func(const char *, int, const char *, const char *);
+void __wrap___assert_func(const char *file, int line, const char *fn, const char *expr) {
+    char msg[512];
+    snprintf(msg, sizeof msg, "assert \"%s\" failed in %s (%s:%d)", expr ? expr : "?", fn ? fn : "?", file ? file : "?", line);
+    abort_report(msg);
+    __real___assert_func(file, line, fn, expr);
+}
+void diagAbortWithResult(Result res) {
+    char msg[64];
+    snprintf(msg, sizeof msg, "libnx abort, result 0x%X", res);
+    abort_report(msg);
+    svcBreak(BreakReason_Panic, (uintptr_t)&res, sizeof res);
+    __builtin_unreachable();
+}
+
+int main(int argc, char **argv) {
+    (void)argc; (void)argv;
+    mkdir(BASE, 0777);
+    mkdir(BASE "/logs", 0777);
+    mkdir(BASE "/GameData", 0777);
+    int fps = 60;                         /* psp2i.ini fps=30 for the game's own rate */
+    read_ini(&fps);
+    char when[32];
+    now_text(when, sizeof when);
+    trail("launches.txt", "%s build %d (v%s)", when, PSP2I_SWITCH_BUILD, PSP2I_SWITCH_VERSION);
+    remove(BASE "/logs/quit.log");
+    if (g_logging) {
+        /* Fully buffered: a write to the SD card can stall for 40 ms, and a
+         * line-buffered log wrote at every spike and every 30 s report. The
+         * buffer goes out when full and at quit. */
+        static char logbuf[1 << 20];
+        if (freopen(BASE "/logs/psp2i_log.txt", "w", stderr)) setvbuf(stderr, logbuf, _IOFBF, sizeof logbuf);
+    } else {
+        freopen("/dev/null", "w", stderr);
+    }
+    fprintf(stderr, "psp2i: Switch 2 port v%s build %d, %s\n", PSP2I_SWITCH_VERSION, PSP2I_SWITCH_BUILD, when);
+
+    const char *root = BASE "/GameData";   /* fonts (flash/), saves (ms/), extracted disc */
+    if (psp_mem_init() != 0) { fail("Out of memory."); return 1; }
+    psp_cpu_reset();
+    size_t elf_len = 0;
+    uint8_t *elf = find_game(root, &elf_len);
+    if (!elf) return 1;
+#ifdef PSP2I_NO_GAME_CODE
+    fail("The game files are set up and usable, but this build has no game code (port/gen).");
+    return 1;
+#endif
+    module_info mi;
+    if (load_elf_buf(elf, elf_len, &mi) != 0) { fail("The EBOOT could not be loaded (see logs/psp2i_log.txt)."); return 1; }
+    fprintf(stderr, "module '%s': entry 0x%08X, gp 0x%08X\n", mi.name, mi.entry, mi.gp);
+
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    padInitializeDefault(&g_pad);
+
+    if (egl_up() != 0) { fail("Video could not start (see logs/psp2i_log.txt)."); egl_down(); return 1; }
+    g_gl_up = 1;
+#ifdef PSP2I_SOFTWARE_VIDEO
+    fprintf(stderr, "video: software GE, libnx framebuffer %dx%d (test build)\n", FB_W, FB_H);
+#else
+    fprintf(stderr, "gl: %s, %s\n", (const char *)eglQueryString(g_dpy, EGL_VENDOR), (const char *)eglQueryString(g_dpy, EGL_VERSION));
+    gl_ge_set_scale(g_scale);
+    gl_ge_set_texture_nearest(g_tex_nearest);
+    fprintf(stderr, "gl: textures %s, screen filter %s, FXAA %s\n", g_tex_nearest ? "nearest" : "as the game sets",
+            g_screen_filter == PF_NEAREST ? "nearest" : g_screen_filter == PF_SHARP_BILINEAR ? "sharp bilinear" : "bilinear", g_fxaa ? "on" : "off");
+    if (gl_load(gl_get) != 0 || gl_ge_init() != 0) { fail("OpenGL setup failed"); egl_down(); return 1; }
+    {
+        int cw, ch;
+        surface_size(&cw, &ch);
+        fprintf(stderr, "gl: surface %dx%d\n", cw, ch);
+    }
+#endif
+
+    preload_iso();
+    psp_hle_init();
+    psp_io_set_root(root);
+    psp_net_set_log(net_line);
+    psp_net_set_forced_off(1);                               /* offline: the WLAN switch reads off */
+    psp_sysmem_set_heap(mi.load_hi, USER_PARTITION_TOP);
+    psp_recomp_register();
+    audio_start();
+    psp_audio_set_sink(audio_sink);
+    atrac_at3_init(NULL);
+    h264_static_init();
+    framerate_set_fast_load(g_fast_load);
+    psp_preempt_set_enabled(g_preempt);
+    psp_sched_set_vblank_60(g_vblank60);
+    fastpaths_set_enabled(g_fastpaths);
+    fprintf(stderr, "fastpaths: %s\n", g_fastpaths ? "native DEFLATE decoder for the game's sceDeflateDecompress" : "off (fastpaths=0)");
+    fprintf(stderr, "display: %s\n", g_vblank60 ? "60.00 Hz, matching the Switch's screen" : "the PSP's 59.94 Hz (vblank60=0)");
+    fprintf(stderr, "threads: %s\n", g_preempt ? "a due vblank preempts long-running game threads" : "preemption only at firmware calls (preempt=0)");
+    fprintf(stderr, "loading: %s\n", g_fast_load ? "fast (speed-ups on)" : "at the PSP's pace (speed-ups off)");
+    framerate_init(fps);
+    fps_meter_init(&g_fm);
+    menu_init(&g_menu, fps, g_fps_on);
+    g_menu.iscale = g_menu.iscale_now = g_scale;
+    g_menu.hidden = MENU_BIT(MENU_RESOLUTION) | MENU_BIT(MENU_RENDERER)
+                  | MENU_BIT(MENU_ATTENUATION) | MENU_BIT(MENU_FONT) | MENU_BIT(MENU_QUIT)
+                  | MENU_BIT(MENU_EXTRACT_MODELS) | MENU_BIT(MENU_LOAD_MODELS) | MENU_BIT(MENU_DEADZONE)
+                  | MENU_BIT(MENU_MOUSE_CAM) | MENU_BIT(MENU_KEYS) | MENU_BIT(MENU_VERTEX_WORK) | MENU_BIT(MENU_FXAA)
+                  | MENU_BIT(MENU_SHARPEN) | MENU_BIT(MENU_SCANLINES)
+                  | MENU_BIT(MENU_BRIGHTNESS) | MENU_BIT(MENU_SATURATION)
+                  | MENU_BIT(MENU_TOUCH_COLOR) | MENU_BIT(MENU_TOUCH_ALPHA)
+                  | MENU_BIT(MENU_TESTS);                       /* the frame-rate tests: done with */
+    menu_set_rs_speed(&g_menu, g_rs_speed);
+    g_menu.rs_on = g_rs_on;
+    g_menu.fog = g_fog;
+    g_menu.aniso = g_aniso;
+    g_menu.draw_dist = g_draw_dist;
+    gl_ge_set_fog(g_fog);
+    gl_ge_set_aniso(menu_aniso_level(&g_menu));
+    gl_ge_set_mipmaps(g_mipmaps);
+    fprintf(stderr, "gl: mipmaps for game textures %s\n", g_mipmaps ? "on" : "off");
+    g_menu.mipmaps = g_mipmaps;
+    g_menu.custom_tex = g_custom_tex;
+    if (g_custom_tex) {
+        gl_ge_set_custom_textures(1, BASE "/textures");
+#ifndef PSP2I_SOFTWARE_VIDEO
+        gl_ge_preload_custom_textures(preload_bar, BASE "/textures/cache.bin");   /* behind the loading bar: nothing loads during play */
+#endif
+    }
+    for (int k = 0; k < VOL_N; k++) g_menu.vol[k] = g_vol[k];
+    g_menu.swap_oc = g_swap_oc;
+    postfx_defaults(&g_menu.post);
+    g_menu.post.scaling = g_screen_filter;
+    g_menu.post.fxaa = g_fxaa;
+    post_apply();
+    audio_apply();
+    camera_init(menu_rs_speed(&g_menu));
+    {   /* the game (this thread) on the highest core the process may use, as in the Melee port; the GE thread
+         * then takes the next free one. Stays where it is if the move is refused. */
+        u64 mask = 0;
+        svcGetInfo(&mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+        const int was = (int)svcGetCurrentProcessorNumber();
+        int core = -1;
+        for (int c = 5; c >= 0 && core < 0; c--) if ((mask >> c) & 1) core = c;
+        if (core >= 0 && core != was) {
+            const Result rc = svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1ull << core);
+            svcSleepThread(0);
+            fprintf(stderr, "cores: process 0x%llx; game thread from core %d to core %d (%s, now on %d)\n", (unsigned long long)mask,
+                    was, core, R_SUCCEEDED(rc) ? "ok" : "refused", (int)svcGetCurrentProcessorNumber());
+        }
+    }
+#ifndef PSP2I_SOFTWARE_VIDEO
+    if (g_ge_thread) {                                        /* OpenGL moves to the GE thread (another core) */
+        ge_ctx_release();
+        if (psp_ge_thread_start(ge_ctx_take) != 0) {
+            fprintf(stderr, "gl: no GE thread; OpenGL stays on the game's thread\n");
+            ge_ctx_take();
+        }
+    } else {
+        fprintf(stderr, "gl: OpenGL on the game's thread (ge_thread=off)\n");
+    }
+#endif
+    psp_sched_set_vblank_hook(on_vblank);
+    watchdog_start();
+#ifdef PSP2I_PROFILE
+    prof_start();
+#endif
+
+    static const char boot_path[] = "disc0:/PSP_GAME/SYSDIR/EBOOT.BIN";
+    const uint32_t argp = psp_sysmem_alloc(0x100, 1);
+    psp_mem_write_block(argp, boot_path, (uint32_t)sizeof boot_path);
+    fprintf(stderr, "starting module_start at 0x%08X (%d fps)\n", mi.entry, fps);
+    const int rc = psp_sched_run(mi.entry, (uint32_t)sizeof boot_path, argp, 0x20, 0x40000, mi.gp);
+#ifdef PSP2I_PROFILE
+    prof_stop();
+#endif
+    watchdog_stop();
+    fprintf(stderr, "psp2i: the game ended (%d)\n", rc);
+    { uint64_t c = 0, b = 0; fastpaths_stats(&c, &b); fprintf(stderr, "  fastpaths           %llu decompressions natively, %llu KB\n", (unsigned long long)c, (unsigned long long)(b >> 10)); }
+    trail("quit.log", "build %d: the game ended (%d) after %llu vblanks", PSP2I_SWITCH_BUILD, rc, (unsigned long long)g_vblanks);
+
+#ifndef PSP2I_SOFTWARE_VIDEO
+    if (psp_ge_threaded()) { psp_ge_thread_report(stderr); psp_ge_thread_stop(ge_ctx_release); }
+    gl_ge_report(stderr);
+#endif
+    audio_stop();
+    egl_down();
+    psp_mem_free();
+    fflush(stderr);
+    return 0;
+}
