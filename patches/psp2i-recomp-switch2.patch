--- a/port/host/framerate.c
+++ b/port/host/framerate.c
@@ -540,6 +540,8 @@ int framerate_normalize(int fps) { return fps >= 120 ? 120 : fps == 60 ? 60 : 30
 static int rate_for(int target) { return target == 120 ? 2 : 1; }
 
 static int g_reissuing;  /* hook_frame re-issues the game's request itself (a new target) */
+static int g_no20;       /* test harness only: the game's 20 fps requests run as 30 */
+void framerate_debug_no20(int on) { g_no20 = on; }
 
 static void hook_set_frame_rate(void (*original)(void)) {
     const uint32_t asked = psp_cpu.r[4];                /* $a0: fps */
@@ -549,6 +551,7 @@ static void hook_set_frame_rate(void (*original)(void)) {
     if (!g_reissuing && g_base > 0 && (int)asked == g_asked) return;
     g_asked = (int)asked;
     if (g_target >= 60 && (asked == 30 || asked == 20 || asked == 60)) psp_cpu.r[4] = (uint32_t)g_target;
+    else if (g_no20 && asked == 20) psp_cpu.r[4] = 30;
     else if (rate_for(g_target) == 2 && asked > 0 && asked < 30) psp_cpu.r[4] = asked * 2;   /* 15 at 120 Hz */
     g_base = g_applied = (int)psp_cpu.r[4];
     g_debt = 0;
@@ -563,12 +566,15 @@ static void hook_set_frame_rate(void (*original)(void)) {
  * carried over (g_debt) and each frame takes the rate whose step is nearest
  * it: 25 ms frames alternate 60 and 30, and the steps add up to the time
  * that passed. */
+static int g_adapt_off;   /* psp2i.ini adaptive=0: every frame steps at the target rate, however long it took */
+void framerate_set_adaptive(int on) { g_adapt_off = !on; }
 static void adapt(double secs) {
     if (g_base <= 0) return;
     static const int RATES[] = { 120, 60, 30, 20, 15 };
+    int eff = 15;
+    if (g_adapt_off) { eff = g_base; g_debt = 0; goto apply; }   /* every frame at the target rate */
     g_debt += secs;
     if (g_debt > 1.0 / 15.0) g_debt = 1.0 / 15.0;    /* longer frames (loading) count as 1/15 s */
-    int eff = 15;
     double best = 1e9;
     for (size_t k = 0; k < sizeof RATES / sizeof RATES[0]; k++) {
         if (RATES[k] > g_base) continue;
@@ -577,6 +583,7 @@ static void adapt(double secs) {
     }
     g_debt -= 1.0 / eff;
     if (g_debt < -1.0 / 30.0) g_debt = -1.0 / 30.0;  /* short frames (fast loading) run ahead by at most a frame */
+apply:
     if (eff == g_applied) return;
     psp_fn_t fill = psp_lookup(FN_TIMING_FILL);
     if (!fill) return;
@@ -588,10 +595,11 @@ static void adapt(double secs) {
     psp_cpu = saved;
     const uint32_t obj = psp_read32(FPS_OBJECT_PTR);
     if (obj) psp_write32(obj + 4, (uint32_t)eff);
-    if (g_adapt_log < 20) {
+    if (g_adapt_log < 2000) {     /* all of them for now: a one-frame step at a dodge roll would show here */
         g_adapt_log++;
-        fprintf(stderr, "framerate: a frame took %.1f ms; the next one steps as %d fps (the game runs at %d)%s\n",
-                secs * 1000.0, eff, g_base, g_adapt_log == 20 ? " -- further changes not logged" : "");
+        fprintf(stderr, "framerate: vblank %llu: a frame took %.1f ms; the next one steps as %d fps (the game runs at %d)%s\n",
+                (unsigned long long)psp_sched_vblank_count(), secs * 1000.0, eff, g_base,
+                g_adapt_log == 2000 ? " -- further changes not logged" : "");
     }
     g_applied = eff;
 }
@@ -647,6 +655,13 @@ static void hook_frame(void (*original)(void)) {
 
 unsigned long long framerate_late_frames(void) { return g_late_frames; }
 
+/* The loading speed-ups: file requests served at the main thread's check,
+ * DLC files stepped back to back, the PDR loop's loading frames thinned. On by
+ * default; off, the game's file thread serves its own queue at the PSP's pace.
+ * Call before framerate_init. */
+static int g_fast_load = 1;
+void framerate_set_fast_load(int on) { g_fast_load = on != 0; }
+
 void framerate_init(int fps) {
     g_target = framerate_normalize(fps);
     psp_sched_set_vblank_rate(rate_for(g_target));
@@ -662,13 +677,15 @@ void framerate_init(int fps) {
     psp_hook_set(FN_STEPPED_UPD, hook_stepped_update);
     psp_hook_set(FN_HUD_SHOW, hook_hud_show);
     psp_hook_set(FN_SLOT_CALL, hook_slot_call);
-    psp_hook_set(FN_FIO_REQUEST, hook_fio_request);
-    psp_hook_set(FN_FIO_TAKE, hook_fio_take);
-    psp_hook_set(FN_FIO_DONE_A, hook_fio_done);
-    psp_hook_set(FN_FIO_DONE_B, hook_fio_done);
-    psp_hook_set(FN_FIO_CHECK, hook_fio_check);
-    psp_hook_set(FN_LOAD_WAIT, hook_load_wait);
-    psp_hook_set(FN_LOAD_FRAME, hook_load_frame);
+    if (g_fast_load) {                     /* the loading speed-ups (see framerate_set_fast_load) */
+        psp_hook_set(FN_FIO_REQUEST, hook_fio_request);
+        psp_hook_set(FN_FIO_TAKE, hook_fio_take);
+        psp_hook_set(FN_FIO_DONE_A, hook_fio_done);
+        psp_hook_set(FN_FIO_DONE_B, hook_fio_done);
+        psp_hook_set(FN_FIO_CHECK, hook_fio_check);
+        psp_hook_set(FN_LOAD_WAIT, hook_load_wait);
+        psp_hook_set(FN_LOAD_FRAME, hook_load_frame);
+    }
     if (g_target >= 60)
